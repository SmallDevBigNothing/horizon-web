<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>Voltan - Vanilla</title>
<link rel="icon" href="data:,">
<style>
/* Generated from crates/horizon-theme by `cargo run -p xtask -- tokens`; do not edit.
   docs/design-system.md describes the tokens. */

:root {
  --page: #ece7f7;
  --plate-soft: #e9e3f8;
  --plate: #ddd4f3;
  --surface: #f8f6fd;
  --rule: #e4ddf4;
  --ink: #1b1530;
  --ink-soft: #3b3354;
  --muted: #585071;
  --accent: #5333c9;
  --on-accent: #ffffff;
  --danger: #a3301d;
  --success: #136336;
  --warn: #7a4f00;
  --side: #e2dbf2;
  --panel: #f8f6fd;
  --raised: #e9e3f8;
  --button: #ddd4f3;
  --button-bevel: #f4f0fe;
  --well: #f3f0fb;
  --bevel: #ffffff;
  --lip: #c3b8e2;
  --outline: #2b2244;
  --face: #5b3fd6;
  --face-bevel: #8069ef;
  --face-lip: #3a2694;
  --on-face: #ffffff;
  color-scheme: light;
  --font: "Geist", ui-sans-serif, system-ui, sans-serif;
  --mono: "Geist Mono", ui-monospace, monospace;
  --pixel: "Pixelify Sans", "Geist", ui-sans-serif, sans-serif;
  --block-outline: 2px;
  --block-bevel: 2px;
  --block-lip: 4px;
  --text-micro: 11px;
  --text-micro-line: 1.5;
  --text-micro-tracking: 0.04em;
  --text-micro-weight: 400;
  --text-caption: 12px;
  --text-caption-line: 1.5;
  --text-caption-tracking: 0em;
  --text-caption-weight: 400;
  --text-label: 13px;
  --text-label-line: 1.5;
  --text-label-tracking: 0em;
  --text-label-weight: 400;
  --text-ui: 14px;
  --text-ui-line: 1.5;
  --text-ui-tracking: 0em;
  --text-ui-weight: 400;
  --text-body: clamp(15px, calc(15px + 2 * (100vw - 375px) / 1065), 17px);
  --text-body-line: 1.6;
  --text-body-tracking: 0em;
  --text-body-weight: 400;
  --text-heading: clamp(20px, calc(20px + 4 * (100vw - 375px) / 1065), 24px);
  --text-heading-line: 1.3;
  --text-heading-tracking: -0.01em;
  --text-heading-weight: 500;
  --text-title: clamp(32px, calc(32px + 16 * (100vw - 375px) / 1065), 48px);
  --text-title-line: 1.05;
  --text-title-tracking: -0.02em;
  --text-title-weight: 500;
  --text-display: clamp(34px, calc(34px + 30 * (100vw - 375px) / 1065), 64px);
  --text-display-line: 1.05;
  --text-display-tracking: -0.025em;
  --text-display-weight: 500;
  --text-wordmark: 18vw;
  --text-wordmark-line: 0.8;
  --text-wordmark-tracking: -0.04em;
  --text-wordmark-weight: 500;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;
  --space-8: 64px;
  --space-9: 96px;
  --gutter: 64px;
  --gutter-narrow: 16px;
  --radius: 8px;
  --radius-plate: 12px;
  --radius-pill: 999px;
  --rule-width: 1px;
  --control: 32px;
  --control-large: 40px;
  --segment: 28px;
  --field: 36px;
  --row: 86px;
  --index: 40px;
  --plate-bleed: 16px;
  --rise: 8px;
  --measure: 56ch;
  --quick: 150ms;
  --ease-quick: cubic-bezier(0.4, 0, 0.2, 1);
  --move: 240ms;
  --ease-move: cubic-bezier(0.23, 1, 0.32, 1);
  --enter: 600ms;
  --ease-enter: cubic-bezier(0.23, 1, 0.32, 1);
  --stagger: 40ms;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --page: #0f0d17;
    --plate-soft: #221e34;
    --plate: #2b2641;
    --surface: #1a1727;
    --rule: #120f1c;
    --ink: #ecedf3;
    --ink-soft: #c5c7d1;
    --muted: #a29cb8;
    --accent: #9a86ff;
    --on-accent: #ffffff;
    --danger: #f07a68;
    --success: #45c27a;
    --warn: #f0b84f;
    --side: #0b0a11;
    --panel: #1a1727;
    --raised: #221e34;
    --button: #2b2641;
    --button-bevel: #3d3560;
    --well: #0c0b12;
    --bevel: #342d52;
    --lip: #07060b;
    --outline: #05040a;
    --face: #5b3fd6;
    --face-bevel: #8a74ff;
    --face-lip: #3a2694;
    --on-face: #ffffff;
    color-scheme: dark;
  }
}

:root[data-theme="dark"] {
  --page: #0f0d17;
  --plate-soft: #221e34;
  --plate: #2b2641;
  --surface: #1a1727;
  --rule: #120f1c;
  --ink: #ecedf3;
  --ink-soft: #c5c7d1;
  --muted: #a29cb8;
  --accent: #9a86ff;
  --on-accent: #ffffff;
  --danger: #f07a68;
  --success: #45c27a;
  --warn: #f0b84f;
  --side: #0b0a11;
  --panel: #1a1727;
  --raised: #221e34;
  --button: #2b2641;
  --button-bevel: #3d3560;
  --well: #0c0b12;
  --bevel: #342d52;
  --lip: #07060b;
  --outline: #05040a;
  --face: #5b3fd6;
  --face-bevel: #8a74ff;
  --face-lip: #3a2694;
  --on-face: #ffffff;
  color-scheme: dark;
}

/* The launcher and the game's canvas. The colours, type and spacing are the
   design tokens (crates/horizon-theme/tokens.css, loaded before this file);
   docs/design-system.md says how they are used: type carries the hierarchy,
   lists instead of cards, one accent used once, space instead of borders. */
* {
  box-sizing: border-box;
}
[hidden] {
  display: none !important;
}
html,
body {
  margin: 0;
  height: 100%;
  background: var(--page, #ece7f7);
  color: var(--ink, #1b1530);
  font: var(--text-ui-weight, 400) var(--text-ui, 14px) / var(--text-ui-line, 1.5) var(--font, ui-sans-serif, system-ui, sans-serif);
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}
body {
  overflow: hidden;
}
body.playing {
  background: #000;
  overscroll-behavior: none;
}
.visually-hidden {
  position: absolute;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
/* ---- The game ---- */
#game-root {
  position: fixed;
  inset: 0;
  display: none;
  background: #000;
}
body.playing #game-root {
  display: block;
}
#horizon {
  display: block;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  touch-action: none;
}
#status {
  position: fixed;
  left: max(8px, env(safe-area-inset-left));
  bottom: max(8px, env(safe-area-inset-bottom));
  z-index: 20;
  max-width: calc(100vw - 16px);
  padding: 4px 8px;
  font: 13px/1.4 var(--mono, ui-monospace, Menlo, monospace);
  color: #fff;
  background: rgb(0 0 0 / 0.55);
  white-space: pre-wrap;
  pointer-events: none;
}
#status.error {
  background: rgb(120 0 0 / 0.85);
}
/* The status box gets in the way once a world is on screen. */
body.running #status:not(.error) {
  display: none;
}
#pick {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 30;
  transform: translate(-50%, -50%);
  min-height: 44px;
  padding: 10px 18px;
  font: 15px var(--font, system-ui, sans-serif);
  color: var(--on-accent, #fff);
  background: var(--accent, #5333c9);
  border: 0;
  border-radius: var(--radius-pill, 999px);
  cursor: pointer;
}
/* ---- The launcher shell ---- */
#launcher {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  height: 100vh;
  height: 100dvh;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) 0 env(safe-area-inset-left);
}
#nav {
  display: flex;
  flex-direction: column;
  gap: var(--space-5, 24px);
  padding: var(--space-5, 24px) var(--space-4, 16px);
  background: var(--side, var(--plate-soft, #e2dbf2));
  overflow-y: auto;
}
.brand {
  display: flex;
  align-items: baseline;
  gap: var(--space-2, 8px);
  padding: 0 var(--space-3, 12px);
}
.wordmark {
  font-size: var(--text-heading, 22px);
  font-weight: 500;
  letter-spacing: -0.02em;
}
.brand .sub {
  color: var(--muted, #585071);
  font: var(--text-micro, 11px) var(--mono, ui-monospace, monospace);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.nav-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-1, 4px);
  margin: 0;
  padding: 0;
  list-style: none;
}
.nav-list a {
  display: flex;
  align-items: center;
  gap: var(--space-3, 12px);
  min-height: var(--control-large, 40px);
  padding: 0 var(--space-3, 12px);
  color: var(--ink-soft, #3b3354);
  text-decoration: none;
  border-radius: var(--radius-pill, 999px);
  transition: background var(--quick, 150ms) var(--ease-quick, ease);
}
.nav-list a:hover {
  background: var(--plate-soft, #e9e3f8);
}
.nav-list a[aria-current="page"] {
  background: var(--ink, #1b1530);
  color: var(--page, #ece7f7);
}
.nav-list svg {
  width: 20px;
  height: 20px;
  flex: none;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}
#page {
  min-width: 0;
  height: 100%;
  overflow-x: hidden;
  overflow-y: auto;
  padding: var(--space-6, 32px) var(--gutter, 64px) var(--space-8, 64px);
  outline: none;
  animation: rise var(--enter, 600ms) var(--ease-enter, ease-out);
}
#page > * {
  max-width: 72ch;
}
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(var(--rise, 8px));
  }
}
h1 {
  margin: 0 0 var(--space-5, 24px);
  font-size: var(--text-title, 40px);
  font-weight: var(--text-title-weight, 500);
  line-height: var(--text-title-line, 1.05);
  letter-spacing: var(--text-title-tracking, -0.02em);
}
h2 {
  margin: 0 0 var(--space-2, 8px);
  font-size: var(--text-heading, 22px);
  font-weight: 500;
  letter-spacing: var(--text-heading-tracking, -0.01em);
}
p {
  margin: 0 0 var(--space-3, 12px);
  max-width: var(--measure, 56ch);
}
.hint {
  color: var(--muted, #585071);
  font-size: var(--text-label, 13px);
}
.foot {
  margin-top: var(--space-6, 32px);
  font-family: var(--mono, ui-monospace, monospace);
  font-size: var(--text-caption, 12px);
}
.empty,
.placeholder {
  color: var(--muted, #585071);
}
.section {
  margin-top: var(--space-7, 48px);
}
.banner {
  padding: var(--space-3, 12px) var(--space-4, 16px);
  color: var(--ink, #1b1530);
  background: var(--plate-soft, #e9e3f8);
  border-radius: var(--radius, 8px);
}
.banner.warning {
  color: var(--warn, #7a4f00);
  background: color-mix(in srgb, var(--warn, #7a4f00) 14%, var(--plate-soft, #e9e3f8));
  border-left: 4px solid var(--warn, #7a4f00);
  font-weight: 600;
}
/* The same warning over the game, the first time Auto lands on WebGL. */
.game-warning {
  position: absolute;
  top: max(12px, env(safe-area-inset-top));
  left: 50%;
  z-index: 20;
  width: min(560px, calc(100% - 32px));
  transform: translateX(-50%);
  padding: var(--space-3, 12px) var(--space-4, 16px);
  color: #fff;
  background: rgb(20 14 0 / 0.86);
  border-left: 4px solid #e0a020;
  border-radius: var(--radius, 8px);
  font: 600 14px / 1.4 var(--font, ui-sans-serif, system-ui, sans-serif);
  pointer-events: none;
}
.banner.error {
  color: var(--danger, #a3301d);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.warn {
  display: block;
  color: var(--warn, #7a4f00);
  font-size: var(--text-caption, 12px);
}
:focus-visible {
  outline: 2px solid var(--accent, #5333c9);
  outline-offset: 2px;
}
/* ---- Controls ---- */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2, 8px);
  min-height: var(--control, 32px);
  padding: 0 var(--space-4, 16px);
  font: inherit;
  color: var(--ink, #1b1530);
  background: var(--plate, #ddd4f3);
  border: 0;
  border-radius: var(--radius-pill, 999px);
  text-decoration: none;
  cursor: pointer;
  transition: background var(--quick, 150ms) var(--ease-quick, ease);
}
.button:hover:not(:disabled) {
  background: var(--plate-soft, #e9e3f8);
  box-shadow: inset 0 0 0 1px var(--lip, #c3b8e2);
}
.button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.button.primary {
  color: var(--on-accent, #fff);
  background: var(--accent, #5333c9);
}
.button.primary:hover:not(:disabled) {
  background: var(--accent, #5333c9);
  filter: brightness(1.08);
}
.button.danger {
  color: var(--danger, #a3301d);
}
.button.icon {
  padding: 0;
  min-width: var(--control, 32px);
}
.button.play {
  min-height: var(--control-large, 40px);
  padding: 0 var(--space-7, 48px);
  font-size: var(--text-body, 16px);
}
.form {
  display: grid;
  gap: var(--space-5, 24px);
  margin-bottom: var(--space-5, 24px);
}
.field {
  display: grid;
  gap: var(--space-2, 8px);
}
.field > label {
  font-size: var(--text-label, 13px);
  color: var(--ink-soft, #3b3354);
}
.field .hint {
  margin: 0;
}
select,
input[type="text"] {
  width: 100%;
  min-width: 0;
  height: var(--field, 36px);
  padding: 0 var(--space-3, 12px);
  font: inherit;
  color: var(--ink, #1b1530);
  background: var(--plate-soft, #e9e3f8);
  border: 1px solid transparent;
  border-radius: var(--radius, 8px);
}
select:focus,
input[type="text"]:focus {
  border-color: var(--accent, #5333c9);
  outline: none;
}
input[type="range"] {
  flex: 1;
  min-width: 0;
  height: 44px;
  accent-color: var(--accent, #5333c9);
}
.range {
  display: flex;
  align-items: center;
  gap: var(--space-3, 12px);
}
.mono,
.index,
output {
  font-family: var(--mono, ui-monospace, monospace);
}
.segmented {
  display: inline-flex;
  flex-wrap: wrap;
  padding: 2px;
  background: var(--plate-soft, #e9e3f8);
  border-radius: var(--radius-pill, 999px);
  width: fit-content;
  max-width: 100%;
}
.segmented label {
  position: relative;
  display: inline-flex;
}
.segmented input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}
.segmented span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--segment, 28px);
  padding: 0 var(--space-4, 16px);
  border-radius: var(--radius-pill, 999px);
  color: var(--ink-soft, #3b3354);
}
.segmented input:checked + span {
  background: var(--ink, #1b1530);
  color: var(--page, #ece7f7);
}
.segmented input:focus-visible + span {
  outline: 2px solid var(--accent, #5333c9);
  outline-offset: 2px;
}
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1, 4px);
  margin-bottom: var(--space-4, 16px);
}
.tab {
  min-height: var(--control, 32px);
  padding: 0 var(--space-4, 16px);
  font: inherit;
  color: var(--ink-soft, #3b3354);
  background: transparent;
  border: 0;
  border-radius: var(--radius-pill, 999px);
  cursor: pointer;
}
.tab:hover {
  background: var(--plate-soft, #e9e3f8);
}
.tab[aria-selected="true"] {
  background: var(--ink, #1b1530);
  color: var(--page, #ece7f7);
}
.tabpanel.greyed .index-list,
.tabpanel.greyed .drop-wrap {
  opacity: 0.45;
}
/* ---- The index list: a mono index, the name, the details and controls ---- */
.index-list {
  margin: 0 0 var(--space-4, 16px);
  padding: 0;
  list-style: none;
}
.row,
.summary {
  display: grid;
  grid-template-columns: var(--index, 40px) minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--space-3, 12px);
  padding: var(--space-3, 12px) 0;
  border-top: var(--rule-width, 1px) solid var(--plate, #ddd4f3);
}
.row:last-child {
  border-bottom: var(--rule-width, 1px) solid var(--plate, #ddd4f3);
}
.summary {
  margin-bottom: var(--space-5, 24px);
  border-bottom: var(--rule-width, 1px) solid var(--plate, #ddd4f3);
}
.summary p {
  margin: 0;
}
.index {
  color: var(--muted, #585071);
  font-size: var(--text-caption, 12px);
}
.main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.main b {
  font-weight: 500;
  overflow-wrap: anywhere;
}
.detail {
  color: var(--muted, #585071);
  font-family: var(--mono, ui-monospace, monospace);
  font-size: var(--text-caption, 12px);
  overflow-wrap: anywhere;
}
.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2, 8px);
}
.switch {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
}
.switch input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}
.switch .track {
  position: relative;
  width: 38px;
  height: 22px;
  background: var(--plate, #ddd4f3);
  border-radius: var(--radius-pill, 999px);
  transition: background var(--quick, 150ms) var(--ease-quick, ease);
}
.switch .track::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 16px;
  height: 16px;
  background: var(--page, #fff);
  border-radius: 50%;
  transition: transform var(--quick, 150ms) var(--ease-quick, ease);
}
.switch input:checked + .track {
  background: var(--accent, #5333c9);
}
.switch input:checked + .track::after {
  transform: translateX(16px);
  background: var(--on-accent, #fff);
}
.switch input:focus-visible + .track {
  outline: 2px solid var(--accent, #5333c9);
  outline-offset: 2px;
}
.switch input:disabled {
  cursor: not-allowed;
}
.drop {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3, 12px);
  padding: var(--space-4, 16px);
  border: 1px dashed var(--lip, #c3b8e2);
  border-radius: var(--radius-plate, 12px);
}
.drop.over {
  background: var(--plate-soft, #e9e3f8);
  border-color: var(--accent, #5333c9);
}
@media (pointer: coarse) {
  .drop .hint {
    display: none;
  }
}
.inline-form {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2, 8px);
}
.inline-form input {
  flex: 1 1 140px;
}
.inline-form .banner {
  flex-basis: 100%;
}
.dialog {
  width: min(440px, calc(100vw - 32px));
  padding: var(--space-5, 24px);
  color: var(--ink, #1b1530);
  background: var(--surface, #f8f6fd);
  border: 0;
  border-radius: var(--radius-plate, 12px);
}
.dialog::backdrop {
  background: rgb(0 0 0 / 0.5);
}
.dialog form {
  display: grid;
  gap: var(--space-4, 16px);
}
.actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2, 8px);
}
#toast {
  position: fixed;
  left: 50%;
  bottom: calc(var(--space-5, 24px) + env(safe-area-inset-bottom));
  z-index: 25;
  max-width: calc(100vw - 32px);
  padding: var(--space-3, 12px) var(--space-4, 16px);
  color: var(--page, #fff);
  background: var(--ink, #1b1530);
  border-radius: var(--radius-pill, 999px);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, var(--rise, 8px));
  transition: opacity var(--quick, 150ms), transform var(--move, 240ms);
}
#toast.on {
  opacity: 1;
  transform: translate(-50%, 0);
}
/* ---- Medium screens: an icon rail ---- */
@media (max-width: 899px) {
  #launcher {
    grid-template-columns: 72px minmax(0, 1fr);
  }
  #nav {
    align-items: center;
    padding: var(--space-4, 16px) var(--space-2, 8px);
  }
  .brand .wordmark,
  .brand .sub,
  .nav-list a span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .nav-list a {
    justify-content: center;
    width: 48px;
    min-height: 48px;
    padding: 0;
  }
  #page {
    padding: var(--space-5, 24px) var(--space-5, 24px) var(--space-7, 48px);
  }
  /* Touch targets: at least 44 by 44 CSS pixels. */
  .button,
  .tab,
  select,
  input[type="text"] {
    min-height: 44px;
    min-width: 44px;
  }
  .segmented span,
  .button.play {
    min-height: 44px;
  }
}
/* ---- Narrow screens: a bottom tab bar, one column, a full-width Play ---- */
@media (max-width: 599px) {
  #launcher {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
  }
  #nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    flex-direction: row;
    padding: 0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    background: var(--side, var(--plate-soft, #e2dbf2));
    border-top: var(--rule-width, 1px) solid var(--plate, #ddd4f3);
    overflow: visible;
  }
  .brand {
    display: none;
  }
  .nav-list {
    flex: 1;
    flex-direction: row;
    gap: 0;
  }
  .nav-list li {
    flex: 1;
    min-width: 0;
  }
  .nav-list a {
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: 100%;
    min-height: 56px;
    padding: 6px 2px;
    border-radius: 0;
    font-size: var(--text-micro, 11px);
  }
  .nav-list a span {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
  }
  .nav-list a[aria-current="page"] {
    background: transparent;
    color: var(--accent, #5333c9);
  }
  #page {
    grid-row: 1;
    padding: var(--space-5, 24px) var(--gutter-narrow, 16px) calc(56px + var(--space-6, 32px) + env(safe-area-inset-bottom));
  }
  #page > * {
    max-width: none;
  }
  h1 {
    margin-bottom: var(--space-4, 16px);
  }
  .button.play {
    width: 100%;
  }
  .row,
  .summary {
    grid-template-columns: var(--index, 40px) minmax(0, 1fr);
  }
  .row .controls,
  .summary .button {
    grid-column: 2;
    justify-content: flex-start;
  }
  .summary .button {
    justify-self: start;
  }
  .segmented {
    width: 100%;
  }
  .segmented label {
    flex: 1;
  }
  #toast {
    bottom: calc(56px + var(--space-4, 16px) + env(safe-area-inset-bottom));
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* Profile page */
.profile-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-6, 32px);
  align-items: start;
}
.profile-grid .form {
  max-width: var(--measure, 56ch);
}
.field .label {
  font-size: var(--text-label, 13px);
  color: var(--ink-soft, #3b3354);
}
.hint.error {
  color: var(--danger, #a3301d);
}
input[aria-invalid="true"] {
  border-color: var(--danger, #a3301d);
}
input[type="file"] {
  width: 100%;
  min-width: 0;
  font: inherit;
  color: var(--ink, #1b1530);
}
.carousel {
  display: grid;
  grid-template-columns: var(--field, 36px) minmax(0, 1fr) var(--field, 36px);
  align-items: center;
  gap: var(--space-2, 8px);
  text-align: center;
}
.preview {
  display: flex;
  gap: var(--space-4, 16px);
  position: sticky;
  top: var(--space-5, 24px);
}
.figure-box {
  position: relative;
  display: grid;
  justify-items: center;
  gap: var(--space-2, 8px);
  margin: 0;
  padding: var(--space-3, 12px);
  background: var(--plate-soft, #e9e3f8);
  border-radius: var(--radius, 8px);
}
.figure {
  width: 96px;
  height: 192px;
  image-rendering: pixelated;
}
.figure-box figcaption {
  color: var(--muted, #585071);
  font-size: var(--text-caption, 12px);
}
.silhouette {
  display: none;
  position: absolute;
  top: var(--space-3, 12px);
  width: 96px;
  height: 192px;
  background: var(--plate, #ddd4f3);
  clip-path: polygon(25% 0, 75% 0, 75% 25%, 100% 25%, 100% 62%, 75% 62%, 75% 100%, 25% 100%, 25% 62%, 0 62%, 0 25%, 25% 25%);
}
.figure-box.missing .silhouette {
  display: block;
}
.head {
  width: 40px;
  height: 40px;
  image-rendering: pixelated;
  border-radius: var(--radius, 8px);
}
.actions.inline {
  justify-content: flex-start;
}
.actions.inline:empty {
  display: none;
}
@media (max-width: 720px) {
  input[type="file"] {
    min-height: 44px;
  }
  .carousel {
    grid-template-columns: 44px minmax(0, 1fr) 44px;
  }
  .profile-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .preview {
    position: static;
    order: -1;
    justify-content: center;
  }
  .figure,
  .silhouette {
    width: 64px;
    height: 128px;
  }
}
.profile-grid .actions {
  justify-content: flex-start;
}
/* ---- Touch controls (web/touch.js): an overlay above the canvas ---- */
#touch {
  --s: var(--touch-scale, 1);
  --btn: max(44px, calc(60px * var(--s)));
  --btn-big: max(56px, calc(80px * var(--s)));
  --glass: color-mix(in srgb, var(--surface, #f8f6fd) 52%, transparent);
  --glass-down: color-mix(in srgb, var(--face, #5b3fd6) 70%, transparent);
  position: absolute;
  inset: 0;
  z-index: 10;
  overflow: hidden;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior: none;
}
#touch * {
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}
.touch-zone {
  position: absolute;
  top: 0;
  bottom: 0;
}
.touch-move-zone {
  left: 0;
  width: 42%;
  top: 22%;
}
.touch-look-zone {
  left: 42%;
  right: 0;
  top: 22%;
}
.touch-menu-zone {
  inset: 0;
}
#touch[data-context="0"] .touch-menu-zone,
#touch[data-context="0"] .touch-menu-only,
#touch:not([data-context="0"]) .touch-play {
  display: none;
}
#touch[data-context="3"] .touch-menu-only:not(.touch-rmb),
#touch[data-context="3"] .touch-rmb {
  display: none;
}
#touch[data-context="3"] .touch-top .touch-pause,
#touch[data-context="3"] .touch-top .touch-fullscreen {
  display: grid;
}
.touch-btn {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--btn);
  height: var(--btn);
  padding: 0;
  color: var(--ink, #1b1530);
  background: var(--glass);
  border: var(--block-outline, 2px) solid var(--outline, #2b2244);
  border-radius: 50%;
  box-shadow: inset 0 var(--block-bevel, 2px) 0 color-mix(in srgb, var(--bevel, #fff) 60%, transparent);
  cursor: pointer;
  font: inherit;
}
.touch-btn .touch-glyph {
  display: block;
  width: 52%;
  height: 52%;
  pointer-events: none;
}
.touch-btn.pressed,
.touch-btn.on {
  background: var(--glass-down);
  color: var(--on-face, #fff);
}
.touch-btn.has-tex {
  background: var(--tex) center / 100% 100% no-repeat;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  image-rendering: pixelated;
}
.touch-btn.has-tex.pressed,
.touch-btn.has-tex.on {
  background: var(--tex-down) center / 100% 100% no-repeat;
}
.touch-btn.has-tex .touch-glyph {
  display: none;
}
/* A small icon (pause) sits in the round button instead of filling it. */
.touch-btn.has-tex.touch-pause {
  background: var(--tex) center / auto 42% no-repeat, var(--glass);
  border: var(--block-outline, 2px) solid var(--outline, #2b2244);
  border-radius: 50%;
}
.touch-btn.has-tex.touch-pause.pressed {
  background: var(--tex-down) center / auto 42% no-repeat, var(--glass-down);
}
/* The small buttons with Bedrock's textures: its dark HUD square (a 4x4 nine-slice,
   1 px edges, drawn pixelated) and its icon on top. */
.touch-btn.mc-btn {
  color: #fff;
  background: none;
  border-radius: 0;
  box-shadow: none;
  border-style: solid;
  border-color: transparent;
  border-width: calc(3px * var(--s));
  border-image: var(--frame) 1 fill / calc(3px * var(--s)) stretch;
  image-rendering: pixelated;
}
.touch-btn.mc-btn.pressed,
.touch-btn.mc-btn.on {
  border-image-source: var(--frame-down);
}
.touch-btn.mc-btn.has-icon .touch-glyph {
  display: none;
}
.touch-btn .touch-icon {
  display: block;
  width: 58%;
  height: 58%;
  background: var(--icon) center / contain no-repeat;
  image-rendering: pixelated;
  pointer-events: none;
}
.touch-btn.pressed .touch-icon {
  opacity: 0.75;
}
/* Bedrock's back chevron is 4x7: a bit smaller, so it matches the other icons' weight. */
.touch-back .touch-icon {
  width: 46%;
  height: 46%;
}
.touch-btn:focus-visible {
  outline: 3px solid var(--accent, #5333c9);
  outline-offset: 2px;
}
.touch-actions {
  position: absolute;
  right: max(16px, env(safe-area-inset-right));
  bottom: max(16px, env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: var(--btn) var(--btn-big);
  grid-template-rows: auto auto;
  align-items: end;
  justify-items: center;
  gap: 10px;
}
.touch-actions .touch-jump {
  width: var(--btn-big);
  height: var(--btn-big);
  grid-column: 2;
  grid-row: 2;
}
.touch-actions .touch-sneak {
  grid-column: 1;
  grid-row: 2;
}
.touch-actions .touch-attack {
  grid-column: 1;
  grid-row: 1;
}
.touch-actions .touch-use {
  grid-column: 2;
  grid-row: 1;
  width: var(--btn);
  height: var(--btn);
}
.touch-top {
  position: absolute;
  top: max(8px, env(safe-area-inset-top));
  right: max(8px, env(safe-area-inset-right));
  display: flex;
  flex-direction: row;
  gap: 8px;
}
.touch-top .touch-btn {
  width: max(44px, calc(46px * var(--s)));
  height: max(44px, calc(46px * var(--s)));
}
.touch-extras {
  position: absolute;
  top: calc(max(8px, env(safe-area-inset-top)) + max(44px, calc(46px * var(--s))) + 8px);
  right: max(8px, env(safe-area-inset-right));
  display: flex;
  gap: 8px;
}
.touch-extras .touch-btn {
  width: max(44px, calc(46px * var(--s)));
  height: max(44px, calc(46px * var(--s)));
}
.touch-rmb {
  position: absolute;
  left: max(8px, env(safe-area-inset-left));
  bottom: max(8px, env(safe-area-inset-bottom));
}
/* The hotbar strip lies over the game's own hotbar (placed by touch.js). */
.touch-hotbar {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: min(420px, 92vw);
  height: 44px;
  display: grid;
  grid-template-columns: repeat(9, 1fr);
}
.touch-slot {
  min-width: 0;
  padding: 0;
  background: transparent;
  border: 0;
  cursor: pointer;
}
.touch-slot:focus-visible {
  outline: 3px solid var(--accent, #5333c9);
  outline-offset: -3px;
}
.touch-stick {
  position: absolute;
  width: calc(var(--s) * 128px);
  height: calc(var(--s) * 128px);
  margin: calc(var(--s) * -64px) 0 0 calc(var(--s) * -64px);
  border-radius: 50%;
  border: var(--block-outline, 2px) solid color-mix(in srgb, var(--outline, #2b2244) 80%, transparent);
  background: color-mix(in srgb, var(--surface, #f8f6fd) 30%, transparent);
  pointer-events: none;
}
.touch-stick.sprint {
  border-color: var(--accent, #5333c9);
}
.touch-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46%;
  height: 46%;
  margin: -23% 0 0 -23%;
  border-radius: 50%;
  background: var(--face, #5b3fd6);
  border: var(--block-outline, 2px) solid var(--outline, #2b2244);
}
.touch-stick.has-tex {
  border: 0;
  border-radius: 0;
  background: var(--tex-frame) center / 100% 100% no-repeat;
  image-rendering: pixelated;
}
.touch-stick.has-tex .touch-knob {
  border: 0;
  border-radius: 0;
  background: var(--tex-knob) center / 100% 100% no-repeat;
  image-rendering: pixelated;
}
.touch-rotate {
  position: absolute;
  left: 50%;
  top: calc(max(8px, env(safe-area-inset-top)) + 64px);
  transform: translateX(-50%);
  max-width: 80%;
  padding: 6px 12px;
  text-align: center;
  color: #fff;
  background: rgb(0 0 0 / 0.6);
  font: 13px/1.4 var(--font, system-ui, sans-serif);
  pointer-events: none;
}
#touch-text {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 44px;
  font-size: 16px; /* 16px stops iOS zooming in on focus */
  opacity: 0;
  border: 0;
  padding: 0;
  pointer-events: none;
}

</style>
</head>
<body>
<div id="launcher"></div>
<div id="game-root"></div>
<div id="status" role="status">Loading Voltan…</div>
<script type="text/plain" data-blob="wasm" data-index="0" data-size="14824233" data-gzip="1"></script>
<script type="text/plain" data-blob="wasm" data-index="1" data-size="14824233" data-gzip="1">