            const instance = await WebAssembly.instantiate(module, imports);

            if (instance instanceof WebAssembly.Instance) {
                return { instance, module };
            } else {
                return instance;
            }
        }

        function expectedResponseType(type) {
            switch (type) {
                case 'basic': case 'cors': case 'default': return true;
            }
            return false;
        }
    }

    function initSync(module) {
        if (wasm !== undefined) return wasm;


        if (module !== undefined) {
            if (Object.getPrototypeOf(module) === Object.prototype) {
                ({module} = module)
            } else {
                console.warn('using deprecated parameters for `initSync()`; pass a single object instead')
            }
        }

        const imports = __wbg_get_imports();
        if (!(module instanceof WebAssembly.Module)) {
            module = new WebAssembly.Module(module);
        }
        const instance = new WebAssembly.Instance(module, imports);
        return __wbg_finalize_init(instance, module);
    }

    async function __wbg_init(module_or_path) {
        if (wasm !== undefined) return wasm;


        if (module_or_path !== undefined) {
            if (Object.getPrototypeOf(module_or_path) === Object.prototype) {
                ({module_or_path} = module_or_path)
            } else {
                console.warn('using deprecated parameters for the initialization function; pass a single object instead')
            }
        }

        if (module_or_path === undefined && script_src !== undefined) {
            module_or_path = script_src.replace(/\.js$/, "_bg.wasm");
        }
        const imports = __wbg_get_imports();

        if (typeof module_or_path === 'string' || (typeof Request === 'function' && module_or_path instanceof Request) || (typeof URL === 'function' && module_or_path instanceof URL)) {
            module_or_path = fetch(module_or_path);
        }

        const { instance, module } = await __wbg_load(await module_or_path, imports);

        return __wbg_finalize_init(instance, module);
    }

    return Object.assign(__wbg_init, { initSync }, exports);
})({ __proto__: null });

return wasm_bindgen;
}
</script>
<script>
// The relays (horizon-web-proxy servers) that carry the game's connections to
// Minecraft servers. The list and the chosen relay are kept in localStorage; the
// launcher's Play and Servers pages show them, and the chosen relay is what
// `set_proxy` is given.
const RELAY_LIST_KEY = "horizon.relays";
const RELAY_CHOSEN_KEY = "horizon.proxy";
const RELAY_DEFAULT = { name: "This computer", url: "ws://127.0.0.1:25580" };
function relayLoad() {
  try {
    const list = JSON.parse(localStorage.getItem(RELAY_LIST_KEY) ?? "null");
    if (Array.isArray(list) && list.length > 0 && list.every((r) => r && typeof r.url === "string")) {
      return list.map((r) => ({ name: String(r.name || r.url), url: r.url }));
    }
  } catch {}
  return [{ ...RELAY_DEFAULT }];
}
// `ws://host:port` or `wss://host:port`, without a trailing slash; else null.
function relayNormalise(url) {
  const trimmed = String(url).trim().replace(/\/+$/, "");
  return /^wss?:\/\/[^\s/]+$/i.test(trimmed) ? trimmed : null;
}
// The relay in use: ?proxy= (`override`), else the one chosen on an earlier visit,
// else the first of the list.
function relayChosen(override) {
  const list = relayLoad();
  const chosen = override ?? localStorage.getItem(RELAY_CHOSEN_KEY) ?? list[0].url;
  return relayNormalise(chosen) ?? list[0].url;
}
function relaySetChosen(url) {
  localStorage.setItem(RELAY_CHOSEN_KEY, url);
}
// Adds (or renames) a relay and chooses it. Returns an error text, or null.
function relayAdd(name, url) {
  const clean = relayNormalise(url);
  if (!clean) return "Use ws://host:port or wss://host:port";
  const list = relayLoad();
  const known = list.find((r) => r.url === clean);
  if (known) known.name = name.trim() || known.name;
  else list.push({ name: name.trim() || clean, url: clean });
  localStorage.setItem(RELAY_LIST_KEY, JSON.stringify(list));
  relaySetChosen(clean);
  return null;
}
// Removes a relay; the list never goes empty. The chosen relay falls back to the first.
function relayRemove(url) {
  const list = relayLoad().filter((r) => r.url !== url);
  const kept = list.length > 0 ? list : [{ ...RELAY_DEFAULT }];
  localStorage.setItem(RELAY_LIST_KEY, JSON.stringify(kept));
  if (localStorage.getItem(RELAY_CHOSEN_KEY) === url) relaySetChosen(kept[0].url);
}

// The launcher's own settings (localStorage), and the servers it lists.
const SETTINGS_KEY = "horizon.launcher.settings";
const SERVERS_KEY = "horizon.launcher.servers";
const SETTINGS_DEFAULT = {
  lang: "en_us",
  theme: "system", // system | light | dark
  renderer: "auto", // auto | webgpu | webgl
  touch: "auto", // auto | on | off
  touchScale: 100, // percent, 50 to 150
};
const SETTINGS_LANGUAGES = [
  ["en_us", "English (US)"],
  ["en_gb", "English (UK)"],
  ["de_de", "Deutsch"],
  ["es_es", "Español"],
  ["fr_fr", "Français"],
  ["it_it", "Italiano"],
  ["nl_nl", "Nederlands"],
  ["pl_pl", "Polski"],
  ["pt_br", "Português (Brasil)"],
  ["ru_ru", "Русский"],
  ["tr_tr", "Türkçe"],
  ["uk_ua", "Українська"],
  ["ja_jp", "日本語"],
  ["ko_kr", "한국어"],
  ["zh_cn", "简体中文"],
];
function settingsLoad() {
  try {
    const stored = JSON.parse(localStorage.getItem(SETTINGS_KEY) ?? "{}");
    const merged = { ...SETTINGS_DEFAULT, ...stored };
    merged.touchScale = Math.min(150, Math.max(50, Number(merged.touchScale) || 100));
    return merged;
  } catch {
    return { ...SETTINGS_DEFAULT };
  }
}
function settingsSave(settings) {
  localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
}
// Applies the theme: no attribute follows the system.
function settingsApplyTheme(theme) {
  if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
  else delete document.documentElement.dataset.theme;
}
// The renderer as a ?renderer= option for the game (the WebGL work reads it from the
// page's address): auto leaves the address as it is.
function settingsApplyRenderer(renderer) {
  const url = new URL(location.href);
  if (renderer === "webgpu" || renderer === "webgl") url.searchParams.set("renderer", renderer);
  else url.searchParams.delete("renderer");
  history.replaceState(history.state, "", url);
}
// Whether the effective renderer is WebGL (shader packs need WebGPU), from the
// choice and what the browser offers; `backend` is what a running game reported.
function settingsIsWebgl(renderer, backend) {
  if (backend) return /webgl/i.test(backend);
  if (renderer === "webgl") return true;
  if (renderer === "webgpu") return false;
  // Auto: what the game used last time (a browser can have navigator.gpu and no
  // usable adapter), else whether the browser has WebGPU at all.
  try {
    const last = localStorage.getItem("horizon.backend");
    if (last) return /webgl/i.test(last);
  } catch {}
  return !("gpu" in navigator);
}
// What the launcher (and the game, the first time) says when Auto lands on WebGL.
const UNSUPPORTED_TEXT =
  "Unsupported system: this browser or device has no usable WebGPU, so Voltan is running in WebGL compatibility mode. Expect severe lag and crashes.";
// Remembers the graphics API a running game reported, for the launcher's greying.
function settingsRememberBackend(backend) {
  try {
    if (backend) localStorage.setItem("horizon.backend", backend);
  } catch {}
}
function serversLoad() {
  try {
    const list = JSON.parse(localStorage.getItem(SERVERS_KEY) ?? "[]");
    if (Array.isArray(list)) {
      return list
        .filter((s) => s && typeof s.address === "string")
        .map((s) => ({ name: String(s.name || s.address), address: s.address, relay: s.relay ?? "" }));
    }
  } catch {}
  return [];
}
function serversSave(list) {
  localStorage.setItem(SERVERS_KEY, JSON.stringify(list));
}
// `host`, `host:port`, `[v6]:port` or ws(s)://host:port; returns the clean address or null.
function serversNormalise(address) {
  const text = String(address).trim();
  if (/^wss?:\/\/[^\s/]+(\/[^\s]*)?$/i.test(text)) return text;
  return /^(\[[0-9a-f:]+\]|[a-z0-9]([a-z0-9.-]*[a-z0-9])?)(:\d{1,5})?$/i.test(text) ? text : null;
}

// The player's packs: mods (.hmod), resource packs, data packs and shader packs.
// The Packs page adds, orders, enables and removes them; they are kept in IndexedDB
// between visits and put in the game's folders before each Play. The game's own
// "Open Pack Folder" button uses the same store.
const PACK_DB = "voltan-packs";
const PACK_STORE = "packs";
const OLD_DB = "voltan-uploads"; // the first version's store, folded in once
const OLD_STORE = "files";
const PACK_MIGRATED_KEY = "horizon.launcher.packs-migrated";
// Mods are switched off in the launcher for now: no Mods tab, and no mod (content
// or code) reaches the game. Mods already stored stay in IndexedDB untouched, so
// turning this back on brings them back as they were.
const MODS_ENABLED = false;
// Where each kind goes in the game's folders, and what the page accepts.
const ALL_PACK_KINDS = {
  mod: { dir: "horizon-mods", label: "Mods", accept: ".hmod", exts: [".hmod"] },
  resource: { dir: "resourcepacks", label: "Resource packs", accept: ".zip", exts: [".zip"] },
  data: { dir: "datapacks", label: "Data packs", accept: ".zip", exts: [".zip"] },
  shader: { dir: "shaderpacks", label: "Shader packs", accept: ".hshader,.zip", exts: [".hshader", ".zip"] },
};
const PACK_KINDS = Object.fromEntries(
  Object.entries(ALL_PACK_KINDS).filter(([kind]) => MODS_ENABLED || kind !== "mod"),
);
function packOpen(name, store, keyPath) {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open(name, 1);
    request.onupgradeneeded = () => request.result.createObjectStore(store, { keyPath });
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}
async function packTransact(mode, work) {
  const db = await packOpen(PACK_DB, PACK_STORE, "id");
  try {
    return await new Promise((resolve, reject) => {
      const transaction = db.transaction(PACK_STORE, mode);
      const result = work(transaction.objectStore(PACK_STORE));
      transaction.oncomplete = () => resolve(result?.result);
      transaction.onerror = () => reject(transaction.error);
      transaction.onabort = () => reject(transaction.error);
    });
  } finally {
    db.close();
  }
}
// The kind of a file in a game folder (`resourcepacks`, ...), or null.
function packKindOfFolder(folder) {
  const last = String(folder).replace(/\/+$/, "").split("/").pop();
  return Object.keys(PACK_KINDS).find((k) => PACK_KINDS[k].dir === last) ?? null;
}
// Where the game finds a pack.
function packPath(pack) {
  return `${PACK_KINDS[pack.kind].dir}/${pack.file}`;
}
// What the game's options call a resource pack.
function packGameId(pack) {
  return `file/${pack.file}`;
}
// Every pack, by kind then order (bottom first).
async function packsAll() {
  let all = [];
  try {
    all = (await packTransact("readonly", (store) => store.getAll())) ?? [];
  } catch (error) {
    console.warn("Horizon: could not read the kept packs", error);
  }
  // Kinds switched off (mods, see MODS_ENABLED) stay stored but are not listed,
  // mounted or sent to the game.
  return all
    .filter((p) => p.kind in PACK_KINDS)
    .sort((a, b) => a.kind.localeCompare(b.kind) || a.order - b.order);
}
async function packsList(kind) {
  return (await packsAll()).filter((p) => p.kind === kind);
}
function packCleanName(name) {
  return name.replace(/[\\/]/g, "_");
}
// Keeps `file` as a pack of `kind`. A name already used gets a number. Returns the record.
async function packsAdd(kind, file) {
  const name = packCleanName(file.name);
  const ext = PACK_KINDS[kind].exts.find((e) => name.toLowerCase().endsWith(e));
  if (!ext) throw new Error(`${name}: ${PACK_KINDS[kind].label} are ${PACK_KINDS[kind].exts.join(" or ")} files`);
  const existing = await packsList(kind);
  const stem = name.slice(0, name.length - ext.length);
  let kept = name;
  for (let n = 2; existing.some((p) => p.file === kept); n++) kept = `${stem} (${n})${ext}`;
  const bytes = new Uint8Array(await file.arrayBuffer());
  const record = {
    id: crypto.randomUUID(),
    kind,
    name: kept.slice(0, kept.length - ext.length),
    file: kept,
    bytes,
    size: bytes.length,
    enabled: kind !== "data" && kind !== "shader",
    order: existing.reduce((top, p) => Math.max(top, p.order + 1), 0),
    added: Date.now(),
    meta: null,
  };
  await packTransact("readwrite", (store) => store.put(record));
  return record;
}
async function packsUpdate(pack) {
  await packTransact("readwrite", (store) => store.put(pack));
}
async function packsRemove(id) {
  await packTransact("readwrite", (store) => store.delete(id));
}
// Moves a pack up (+1) or down (-1) among the packs of its kind.
async function packsMove(id, delta) {
  const all = await packsAll();
  const pack = all.find((p) => p.id === id);
  if (!pack) return;
  const same = all.filter((p) => p.kind === pack.kind);
  const from = same.indexOf(pack);
  const to = from + delta;
  if (to < 0 || to >= same.length) return;
  same.splice(to, 0, same.splice(from, 1)[0]);
  await Promise.all(same.map((p, order) => packsUpdate({ ...p, order })));
}
// The first version kept files by path; fold them in as packs once.
async function packsMigrate() {
  if (localStorage.getItem(PACK_MIGRATED_KEY)) return;
  try {
    const db = await packOpen(OLD_DB, OLD_STORE, "path");
    const old = await new Promise((resolve, reject) => {
      const request = db.transaction(OLD_STORE, "readonly").objectStore(OLD_STORE).getAll();
      request.onsuccess = () => resolve(request.result ?? []);
      request.onerror = () => reject(request.error);
    });
    db.close();
    for (const { path, bytes } of old) {
      const kind = packKindOfFolder(path.split("/").slice(0, -1).join("/"));
      if (!kind) continue;
      const file = new File([bytes], path.split("/").pop());
      await packsAdd(kind, file).catch((error) => console.warn("Horizon: not migrated", path, error));
    }
    localStorage.setItem(PACK_MIGRATED_KEY, "1");
  } catch (error) {
    console.warn("Horizon: could not fold in the earlier packs", error);
  }
}
let packSink = null;
// The running game takes files the in-game picker adds: `add(path, bytes)`, or null.
function packsSetSink(add) {
  packSink = add;
}
// The game's "Open Pack Folder" button (`horizonPickFiles(folder)`): the same store
// as the Packs page, so the pack is kept and listed there too.
function installUploads() {
  window.horizonPickFiles = (folder) => {
    const kind = packKindOfFolder(folder);
    if (!kind) return;
    const input = document.createElement("input");
    input.type = "file";
    input.multiple = true;
    input.accept = PACK_KINDS[kind].accept;
    input.addEventListener("change", async () => {
      for (const file of input.files) {
        try {
          const pack = await packsAdd(kind, file);
          packSink?.(packPath(pack), pack.bytes);
        } catch (error) {
          console.warn(`Horizon: could not keep ${file.name}`, error);
        }
      }
    });
    input.click();
  };
}

// The player's profile: the offline name, skin, arms and cape, edited on the launcher's
// Profile page and handed to the game on every Play (`set_profile`). The game has no
// screen for it. A profile is stored in two places: the small facts in localStorage
// (`horizon.launcher.profile`) and the PNG bytes in IndexedDB (`voltan-profile`).
// With no stored profile the game keeps its default name and skin.
const PROFILE_KEY = "horizon.launcher.profile";
const PROFILE_DB = "voltan-profile";
const PROFILE_STORE = "blobs";
const PROFILE_CHARACTERS = ["steve", "alex", "ari", "efe", "kai", "makena", "noor", "sunny", "zuri"];
const PROFILE_PNG_MAX = 1024 * 1024;
const PROFILE_PNG_SIGNATURE = [137, 80, 78, 71, 13, 10, 26, 10];
const PROFILE_NAME_RULE =
  "A name is 1 to 16 characters: letters, digits and symbols, no spaces, accents or emoji.";

// Vanilla's StringUtil.isValidPlayerName (checked in the 26.3 jar): at most 16 chars,
// each one above 32 and below 127; and not empty, as the login sends at least one. This
// is horizon_client::offline_name::is_valid, which set_profile checks again.
function profileNameError(name) {
  if (name.length === 0) return `Enter a name. ${PROFILE_NAME_RULE}`;
  if (name.length > 16) return `That name is ${name.length} characters. ${PROFILE_NAME_RULE}`;
  for (let i = 0; i < name.length; i += 1) {
    const code = name.charCodeAt(i);
    if (code <= 32 || code >= 127) {
      return code === 32
        ? `A name cannot have a space. ${PROFILE_NAME_RULE}`
        : `A name cannot have “${name[i]}”. ${PROFILE_NAME_RULE}`;
    }
  }
  return null;
}

// Offline names are generated as `Player` and five digits (offline_name::generate).
function profileGenerateName() {
  return `Player${String(Math.floor(Math.random() * 100000)).padStart(5, "0")}`;
}

// ---- PNG checks (launcher/src/skins.rs: read_skin, read_cape) ----------------------
// Returns { bytes, width, height } or throws an Error with the sentence to show.
function profileCheckPng(bytes, kind) {
  if (bytes.length > PROFILE_PNG_MAX) throw new Error("That picture is over 1 MB.");
  const isPng = PROFILE_PNG_SIGNATURE.every((b, i) => bytes[i] === b);
  if (!isPng || bytes.length < 33) throw new Error("That file is not a PNG picture.");
  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  const width = view.getUint32(16);
  const height = view.getUint32(20);
  if (kind === "skin" && !(width === 64 && (height === 64 || height === 32))) {
    throw new Error(`A skin is 64×64 (or the older 64×32) pixels; this one is ${width}×${height}.`);
  }
  if (kind === "cape" && !((width === 64 && height === 32) || (width === 22 && height === 17))) {
    throw new Error(`A cape is 64×32 (or the older 22×17) pixels; this one is ${width}×${height}.`);
  }
  return { bytes, width, height };
}

// ---- Storage -------------------------------------------------------------------------
function profileDb() {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open(PROFILE_DB, 1);
    request.onupgradeneeded = () => request.result.createObjectStore(PROFILE_STORE, { keyPath: "id" });
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}

async function profileBlobs(work) {
  const db = await profileDb();
  try {
    return await new Promise((resolve, reject) => {
      const transaction = db.transaction(PROFILE_STORE, "readwrite");
      const result = work(transaction.objectStore(PROFILE_STORE));
      transaction.oncomplete = () => resolve(result?.result);
      transaction.onerror = () => reject(transaction.error);
      transaction.onabort = () => reject(transaction.error);
    });
  } finally {
    db.close();
  }
}

// The stored profile's facts, or null before the player saved one.
function profileLoad() {
  try {
    const stored = JSON.parse(localStorage.getItem(PROFILE_KEY) ?? "null");
    if (!stored || profileNameError(String(stored.name ?? ""))) return null;
    const skin = stored.skin === "custom" || PROFILE_CHARACTERS.includes(stored.skin) ? stored.skin : "steve";
    return { name: stored.name, skin, slim: Boolean(stored.slim), hasCape: Boolean(stored.hasCape) };
  } catch {
    return null;
  }
}

// The PNG bytes kept for the stored profile: { skin, cape } (each a Uint8Array or null).
async function profilePictures() {
  const out = { skin: null, cape: null };
  try {
    await profileBlobs((store) => {
      for (const id of ["skin", "cape"]) {
        const request = store.get(id);
        request.onsuccess = () => (out[id] = request.result?.bytes ?? null);
      }
    });
  } catch {}
  return out;
}

async function profileSave(profile, skinBytes, capeBytes) {
  await profileBlobs((store) => {
    for (const [id, bytes] of [["skin", skinBytes], ["cape", capeBytes]]) {
      if (bytes) store.put({ id, bytes });
      else store.delete(id);
    }
  });
  localStorage.setItem(
    PROFILE_KEY,
    JSON.stringify({ name: profile.name, skin: profile.skin, slim: profile.slim, hasCape: Boolean(capeBytes) }),
  );
}

async function profileForget() {
  localStorage.removeItem(PROFILE_KEY);
  // The game's copies go too: it makes a new name and wears Steve (persist.rs keeps them).
  localStorage.removeItem("horizon.name");
  localStorage.removeItem("horizon.file:/horizon/horizon-player.txt");
  try {
    await profileBlobs((store) => store.clear());
  } catch {}
}

// Gives the game the stored profile, or tells it there is none (session.js, before
// run_game). A refusal from the game (it checks the pictures again) is thrown.
async function profileSend(wasm) {
  const stored = profileLoad();
  if (!stored) {
    wasm.clear_profile();
    return;
  }
  const pictures = await profilePictures();
  const skin = stored.skin === "custom" && pictures.skin ? "custom" : stored.skin === "custom" ? "steve" : stored.skin;
  wasm.set_profile(
    stored.name,
    skin,
    stored.slim,
    skin === "custom" ? pictures.skin : undefined,
    stored.hasCape ? (pictures.cape ?? undefined) : undefined,
  );
}

// ---- Drawing the player (launcher/src/skins.rs: front, cape_front) -------------------
// Parts of the skin: [x, y, w, h, to x, to y, mirrored].
function profileParts(modern, slim, back) {
  const arm = slim ? 3 : 4;
  const base = [];
  const outer = [[back ? 56 : 40, 8, 8, 8, 4, 0, false]];
  if (!back) {
    base.push(
      [8, 8, 8, 8, 4, 0, false],
      [20, 20, 8, 12, 4, 8, false],
      [44, 20, arm, 12, 4 - arm, 8, false],
      [4, 20, 4, 12, 4, 20, false],
    );
    if (modern) {
      base.push([36, 52, arm, 12, 12, 8, false], [20, 52, 4, 12, 8, 20, false]);
      outer.push(
        [20, 36, 8, 12, 4, 8, false],
        [44, 36, arm, 12, 4 - arm, 8, false],
        [52, 52, arm, 12, 12, 8, false],
        [4, 36, 4, 12, 4, 20, false],
        [4, 52, 4, 12, 8, 20, false],
      );
    } else {
      base.push([44, 20, arm, 12, 12, 8, true], [4, 20, 4, 12, 8, 20, true]);
    }
  } else {
    // The back faces: the same boxes, seen from behind (the right arm is on the right).
    const right = slim ? 51 : 52;
    base.push(
      [24, 8, 8, 8, 4, 0, false],
      [32, 20, 8, 12, 4, 8, false],
      [right, 20, arm, 12, 12, 8, false],
      [12, 20, 4, 12, 8, 20, false],
    );
    if (modern) {
      base.push([slim ? 43 : 44, 52, arm, 12, 4 - arm, 8, false], [28, 52, 4, 12, 4, 20, false]);
      outer.push(
        [32, 36, 8, 12, 4, 8, false],
        [right, 36, arm, 12, 12, 8, false],
        [slim ? 59 : 60, 52, arm, 12, 4 - arm, 8, false],
        [12, 36, 4, 12, 8, 20, false],
        [12, 52, 4, 12, 4, 20, false],
      );
    } else {
      base.push([right, 20, arm, 12, 4 - arm, 8, true], [12, 20, 4, 12, 4, 20, true]);
    }
  }
  return [base, outer];
}

// The player's front or back as 16×32 RGBA, from a skin's ImageData and an optional cape.
function profileFigure(skin, slim, back, cape) {
  const out = new ImageData(16, 32);
  const modern = skin.height === 64;
  const layers = profileParts(modern, slim, back);
  layers.forEach((parts, layer) => {
    for (const [fx, fy, pw, ph, tx, ty, mirrored] of parts) {
      for (let dy = 0; dy < ph; dy += 1) {
        for (let dx = 0; dx < pw; dx += 1) {
          const sx = mirrored ? fx + pw - 1 - dx : fx + dx;
          const at = ((fy + dy) * skin.width + sx) * 4;
          // The base layer is opaque in the game; an outer one shows where it is drawn.
          if (layer === 0 || skin.data[at + 3] > 0) {
            const to = ((ty + dy) * 16 + (tx + dx)) * 4;
            out.data.set(skin.data.subarray(at, at + 3), to);
            out.data[to + 3] = 255;
          }
        }
      }
    }
  });
  if (back && cape) {
    // The cape hangs over the back from the shoulders: its outside, 10×16 at (1,1).
    for (let y = 0; y < 16; y += 1) {
      for (let x = 0; x < 10; x += 1) {
        const at = ((1 + y) * cape.width + (1 + x)) * 4;
        const to = ((8 + y) * 16 + (3 + x)) * 4;
        out.data.set(cape.data.subarray(at, at + 3), to);
        out.data[to + 3] = 255;
      }
    }
  }
  return out;
}

async function profileImageData(bytes) {
  const bitmap = await createImageBitmap(new Blob([bytes], { type: "image/png" }));
  const canvas = new OffscreenCanvas(bitmap.width, bitmap.height);
  const context = canvas.getContext("2d");
  context.drawImage(bitmap, 0, 0);
  const data = context.getImageData(0, 0, bitmap.width, bitmap.height);
  bitmap.close();
  return data;
}

// Whether the launcher's own instance has the game's resources (the default skins).
const profileResources = { service: null, ready: false, listeners: [] };

// Mounts the resource package in the launcher's instance so default skins can be drawn;
// the checksum takes a moment, so it waits for the page to be idle. Whatever waited for
// the skins (the preview, the Play summary's head) is told after.
function profileMountResources(service, bytes) {
  profileResources.service = service;
  setTimeout(() => {
    try {
      service.mount_resources(bytes);
      profileResources.ready = true;
    } catch (error) {
      console.warn("Horizon: default skins cannot be drawn:", error);
    }
    const waiting = profileResources.listeners.splice(0);
    for (const listener of waiting) listener();
  }, 0);
}

async function profileSkinData(look, skinBytes) {
  if (look.skin === "custom") return skinBytes ? profileImageData(skinBytes) : null;
  if (!profileResources.ready) return null;
  const index = Math.max(0, PROFILE_CHARACTERS.indexOf(look.skin));
  return profileImageData(profileResources.service.default_skin_png(index, look.slim));
}

// Draws the player into the two canvases (front, back), or leaves them empty (the page
// then shows a silhouette) when the skin cannot be read.
async function profileDraw(canvases, look, skinBytes, capeBytes) {
  const skin = await profileSkinData(look, skinBytes).catch(() => null);
  const cape = capeBytes ? await profileImageData(capeBytes).catch(() => null) : null;
  for (const [canvas, back] of [[canvases.front, false], [canvases.back, true]]) {
    const context = canvas.getContext("2d");
    context.clearRect(0, 0, 16, 32);
    if (skin) context.putImageData(profileFigure(skin, look.slim, back, cape), 0, 0);
    canvas.parentElement.classList.toggle("missing", !skin);
  }
}

function profileCanvas(label) {
  const canvas = document.createElement("canvas");
  canvas.width = 16;
  canvas.height = 32;
  canvas.className = "figure";
  const box = document.createElement("figure");
  box.className = "figure-box";
  const caption = document.createElement("figcaption");
  caption.textContent = label;
  const silhouette = document.createElement("span");
  silhouette.className = "silhouette";
  silhouette.setAttribute("aria-hidden", "true");
  box.append(canvas, silhouette, caption);
  return { box, canvas };
}

// The head of the stored profile's skin, for the Play page's summary; a 32×32 canvas.
function profileHead(service) {
  const canvas = document.createElement("canvas");
  canvas.width = 8;
  canvas.height = 8;
  canvas.className = "head";
  canvas.setAttribute("aria-hidden", "true");
  const stored = profileLoad();
  const draw = async () => {
    const look = stored ?? { skin: "steve", slim: false };
    const pictures = look.skin === "custom" ? await profilePictures() : null;
    const skin = await profileSkinData(look, pictures?.skin);
    if (!skin) return;
    const figure = profileFigure(skin, look.slim, false, null);
    const head = new ImageData(8, 8);
    for (let y = 0; y < 8; y += 1) head.data.set(figure.data.subarray((y * 16 + 4) * 4, (y * 16 + 12) * 4), y * 32);
    canvas.getContext("2d").putImageData(head, 0, 0);
  };
  const start = () => draw().catch(() => {});
  if (!profileResources.ready) profileResources.listeners.push(start);
  start();
  return canvas;
}

// ---- The Profile page ---------------------------------------------------------------
// `mount`: the page's element; `ctx`: { toast, ask, h, field, segmented } from the launcher.
function profileRenderPage(mount, ctx) {
  const { toast, ask, h, field, segmented } = ctx;
  const stored = profileLoad();
  const draft = {
    name: stored?.name ?? profileGenerateName(),
    skin: stored?.skin ?? "steve",
    slim: stored?.slim ?? false,
    source: stored?.skin === "custom" ? "custom" : "default",
    skinBytes: null,
    capeBytes: null,
    saved: Boolean(stored),
    loaded: false,
  };
  const messages = { name: null, skin: null, cape: null, form: null };
  let preview = null;

  const redraw = () => {
    if (!preview) return;
    const look = { skin: draft.source === "custom" ? "custom" : draft.skin, slim: draft.slim };
    profileDraw(preview, look, draft.skinBytes, draft.capeBytes);
  };

  const say = (node, text) => {
    node.textContent = text ?? "";
    node.hidden = !text;
  };

  const render = () => {
    // A control that had the focus keeps it across the rebuild.
    const active = mount.contains(document.activeElement) ? document.activeElement : null;
    const again = active?.getAttribute("aria-label")
      ? `[aria-label="${active.getAttribute("aria-label")}"]`
      : active?.type === "radio"
        ? `input[name="${active.name}"][value="${active.value}"]`
        : null;
    const note = (id, key) => {
      const node = h("p", { class: "hint error", id, role: "alert", hidden: true });
      say(node, messages[key]);
      return node;
    };
    const nameError = note("profile-name-error", "name");
    const nameInput = h("input", {
      type: "text",
      value: draft.name,
      maxLength: 16,
      autocomplete: "off",
      autocapitalize: "off",
      spellcheck: false,
      "aria-describedby": "profile-name-error",
      oninput: () => {
        draft.name = nameInput.value;
        messages.name = profileNameError(draft.name);
        nameInput.setAttribute("aria-invalid", messages.name ? "true" : "false");
        say(nameError, messages.name);
      },
    });
    const skinError = note("profile-skin-error", "skin");
    const capeError = note("profile-cape-error", "cape");
    const formError = h("p", { class: "banner error", role: "alert", hidden: true });
    say(formError, messages.form);

    const stepSkin = (by) => {
      const at = PROFILE_CHARACTERS.indexOf(draft.skin);
      draft.skin = PROFILE_CHARACTERS[(at + by + PROFILE_CHARACTERS.length) % PROFILE_CHARACTERS.length];
      // Alex is the one character slim by default.
      draft.slim = draft.skin === "alex";
      render();
    };
    const label = draft.skin[0].toUpperCase() + draft.skin.slice(1);

    const pick = (kind, input) => async () => {
      const file = input.files?.[0];
      input.value = "";
      if (!file) return;
      const key = kind === "skin" ? "skin" : "cape";
      try {
        const checked = profileCheckPng(new Uint8Array(await file.arrayBuffer()), kind);
        if (kind === "skin") {
          draft.skinBytes = checked.bytes;
          draft.source = "custom";
        } else draft.capeBytes = checked.bytes;
        messages[key] = null;
      } catch (error) {
        messages[key] = error.message;
      }
      render();
    };
    const skinFile = h("input", { type: "file", accept: "image/png", "aria-describedby": "profile-skin-error" });
    skinFile.addEventListener("change", pick("skin", skinFile));
    const capeFile = h("input", { type: "file", accept: "image/png", "aria-describedby": "profile-cape-error" });
    capeFile.addEventListener("change", pick("cape", capeFile));

    const front = profileCanvas("Front");
    const back = profileCanvas("Back");
    preview = { front: front.canvas, back: back.canvas };

    const skinControls =
      draft.source === "custom"
        ? [
            field("Skin PNG", skinFile, "64×64 or 64×32 pixels, up to 1 MB."),
            h("p", { class: "hint" }, draft.skinBytes ? "Your skin is picked." : "Choose a skin picture."),
            skinError,
          ]
        : [
            h(
              "div",
              { class: "carousel", role: "group", "aria-label": "Default skin" },
              h("button", { type: "button", class: "button", "aria-label": "Previous skin", onclick: () => stepSkin(-1) }, "‹"),
              h("b", { "aria-live": "polite" }, label),
              h("button", { type: "button", class: "button", "aria-label": "Next skin", onclick: () => stepSkin(1) }, "›"),
            ),
          ];

    const save = h("button", { type: "button", class: "button primary", onclick: () => doSave() }, "Save");
    const reset = h("button", { type: "button", class: "button", onclick: () => doReset() }, "Reset to default");
    mount.replaceChildren(
      h(
        "div",
        { class: "profile-grid" },
        h(
          "div",
          { class: "form" },
          formError,
          field("Name", nameInput, PROFILE_NAME_RULE),
          nameError,
          h("div", { class: "field" }, h("span", { class: "label" }, "Skin"), segmented("Skin", [["default", "Default"], ["custom", "Custom PNG"]], draft.source, (key) => {
            draft.source = key;
            render();
          })),
          ...skinControls,
          h("div", { class: "field" }, h("span", { class: "label" }, "Arms"), segmented("Arms", [["wide", "Wide"], ["slim", "Slim"]], draft.slim ? "slim" : "wide", (key) => {
            draft.slim = key === "slim";
            redraw();
          })),
          field("Cape PNG", capeFile, "64×32 or 22×17 pixels, up to 1 MB. Optional."),
          h(
            "div",
            { class: "actions inline" },
            draft.capeBytes
              ? h("button", { type: "button", class: "button", onclick: () => ((draft.capeBytes = null), render()) }, "Remove cape")
              : null,
          ),
          capeError,
          h("div", { class: "actions" }, save, reset),
          h(
            "p",
            { class: "hint" },
            draft.saved
              ? "Saved. The game wears this every time you press Play."
              : "Not saved yet. Without a saved profile the game uses a generated name and Steve.",
          ),
        ),
        h("div", { class: "preview", "aria-label": "Preview of your player" }, front.box, back.box),
      ),
    );
    redraw();
    if (again) mount.querySelector(again)?.focus();
  };

  const doSave = async () => {
    messages.name = profileNameError(draft.name);
    messages.form = null;
    if (draft.source === "custom" && !draft.skinBytes) messages.skin = "Choose a skin picture, or pick a default skin.";
    if (messages.name || (draft.source === "custom" && !draft.skinBytes)) {
      render();
      (mount.querySelector("[aria-invalid=true], input[type=file]") ?? mount).focus?.();
      return;
    }
    try {
      await profileSave(
        { name: draft.name, skin: draft.source === "custom" ? "custom" : draft.skin, slim: draft.slim },
        draft.source === "custom" ? draft.skinBytes : null,
        draft.capeBytes,
      );
      draft.saved = true;
      messages.skin = null;
      render();
      toast("Profile saved. It applies the next time you press Play.");
    } catch (error) {
      messages.form = `The profile could not be saved: ${error?.message ?? error}`;
      render();
    }
  };

  const doReset = async () => {
    if (!(await ask("Remove your saved profile? The game will use a generated name and Steve.", "Reset"))) return;
    await profileForget();
    Object.assign(draft, {
      name: profileGenerateName(),
      skin: "steve",
      slim: false,
      source: "default",
      skinBytes: null,
      capeBytes: null,
      saved: false,
    });
    Object.assign(messages, { name: null, skin: null, cape: null, form: null });
    render();
    toast("Profile reset.");
  };

  render();
  if (!profileResources.ready) {
    profileResources.listeners.push(() => {
      if (mount.isConnected) redraw();
    });
  }
  // The saved pictures come from IndexedDB.
  if (stored) {
    profilePictures().then((pictures) => {
      draft.skinBytes = pictures.skin;
      draft.capeBytes = stored.hasCape ? pictures.cape : null;
      if (draft.source === "custom" && !draft.skinBytes) draft.source = "default";
      draft.loaded = true;
      if (mount.isConnected) render();
    });
  }
}

// Touch controls: an HTML overlay above the game's canvas.
//
// Detection is by capability, never by user agent: a coarse primary pointer, or a touch
// screen with no fine pointer beside it, turns them on in Auto; a touch on a laptop that
// has both turns them on live. The overlay turns Pointer Events into the game's own
// input through wasm exports (touch_move, touch_look, touch_button, touch_pointer ...,
// see crates/horizon-client-web/src/touch_api.rs): a floating joystick on the left,
// drag-to-look on the right (tap uses, hold attacks), buttons, a hotbar strip over the
// game's own hotbar, and, behind a screen, touches that become mouse clicks. The soft
// keyboard types through a hidden <input>. Nothing here outlives the Play: touchStart
// returns a handle whose stop() removes every listener, timer and element.
//
// Mojang's touch textures, when the build has them (web/build-single.py embeds
// .local/private-web/touch/*.png as <script id="touch-textures">), dress the buttons;
// without them, or for one that fails to decode, a CSS/SVG glyph is drawn instead.
const TOUCH_JOY_RADIUS = 56; // CSS px at 100 %
// `?touchdebug=1`: a red dot where the browser says the finger is (position: fixed,
// so it is in viewport coordinates) and the numbers the joystick is placed from.
const TOUCH_DEBUG = /[?&]touchdebug=1\b/.test(location.search);
// Whether a pointer event carries the finger's position. Some phone browsers send a
// touch's pointerdown with clientX = clientY = 0 (seen on a real phone with the debug
// readout); the corner pixel itself is never a place a thumb starts from.
function touchHasPosition(event) {
  return event.clientX !== 0 || event.clientY !== 0;
}
// What the debug readout knows: the last pointer and Touch Event positions.
const touchDebugState = { pointer: "none yet", touch: "none yet", blind: false, stick: "hidden" };
globalThis.addEventListener?.("pointerdown", (e) => {
  if (TOUCH_DEBUG) touchDebugState.pointer = `${e.type} ${e.pointerType} ${Math.round(e.clientX)},${Math.round(e.clientY)}`;
}, true);
function touchDebugTouch(event) {
  const t = event.changedTouches[0];
  if (t) touchDebugState.touch = `${event.type} ${Math.round(t.clientX)},${Math.round(t.clientY)}`;
  touchDebugPaint();
}
function touchDebugShow(point, box, stick, blind) {
  touchDebugState.blind = blind;
  requestAnimationFrame(() => {
    const s = stick.getBoundingClientRect();
    touchDebugState.stick = stick.hidden
      ? "hidden"
      : `centre ${Math.round(s.left + s.width / 2)},${Math.round(s.top + s.height / 2)} size ${Math.round(s.width)}`;
    touchDebugState.overlay = `${Math.round(box.left)},${Math.round(box.top)}`;
    touchDebugPaint(point);
  });
}
function touchDebugPaint(point) {
  let dot = document.getElementById("touch-debug-dot");
  let text = document.getElementById("touch-debug-text");
  if (!dot) {
    dot = document.createElement("div");
    dot.id = "touch-debug-dot";
    dot.style.cssText =
      "position:fixed;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;" +
      "background:red;z-index:99999;pointer-events:none";
    text = document.createElement("pre");
    text.id = "touch-debug-text";
    text.style.cssText =
      "position:fixed;left:50%;top:4px;transform:translateX(-50%);margin:0;padding:4px 6px;" +
      "font:11px/1.3 monospace;background:#000c;color:#fff;z-index:99999;pointer-events:none";
    document.body.append(dot, text);
  }
  if (point) {
    dot.style.left = `${point[0]}px`;
    dot.style.top = `${point[1]}px`;
  }
  const s = touchDebugState;
  text.textContent = [
    `pointer: ${s.pointer}`,
    `touch:   ${s.touch}`,
    `blind ${s.blind}  stick ${s.stick}  overlay ${s.overlay ?? "?"}`,
    `inner ${innerWidth}x${innerHeight} dpr ${devicePixelRatio}`,
    navigator.userAgent.slice(0, 70),
  ].join("\n");
}
const TOUCH_TAP_MS = 200;
const TOUCH_HOLD_MS = 350;
const TOUCH_SLOP = 10;
const TOUCH_VIEWPORT_PLAY =
  "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content";
let touchSeen = false; // a touch pointer was seen on a device that Auto left off
// Counted for the leak check: every listener the overlay adds is removed on stop().
const touchStats = { added: 0, removed: 0, timers: 0, taps: 0, holds: 0 };
globalThis.horizonTouchStats = touchStats;
// The glyphs of the fallback (24x24 viewBox, drawn with currentColor).
const TOUCH_GLYPHS = {
  jump: '<path d="M12 4l7 8h-4.5v8h-5v-8H5z" fill="currentColor"/>',
  sneak: '<path d="M12 20l-7-8h4.5V4h5v8H19z" fill="currentColor"/>',
  attack: '<path d="M4 20L18 6m0 0h-5m5 0v5" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="square"/>',
  use: '<rect x="6" y="6" width="12" height="12" stroke="currentColor" stroke-width="3" fill="none"/><rect x="10" y="10" width="4" height="4" fill="currentColor"/>',
  inventory:
    '<path d="M4 8h16v12H4zM8 8V5h8v3M4 13h16" stroke="currentColor" stroke-width="2.5" fill="none"/>',
  chat: '<path d="M4 5h16v11h-8l-5 4v-4H4z" stroke="currentColor" stroke-width="2.5" fill="none"/>',
  pause: '<path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/>',
  more: '<circle cx="5" cy="12" r="2.4" fill="currentColor"/><circle cx="12" cy="12" r="2.4" fill="currentColor"/><circle cx="19" cy="12" r="2.4" fill="currentColor"/>',
  fullscreen: '<path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" stroke="currentColor" stroke-width="2.5" fill="none"/>',
  back: '<path d="M14 5l-7 7 7 7M7 12h13" stroke="currentColor" stroke-width="2.8" fill="none"/>',
  drop: '<path d="M12 4v10m0 0l-4-4m4 4l4-4M5 19h14" stroke="currentColor" stroke-width="2.6" fill="none"/>',
  perspective: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" stroke="currentColor" stroke-width="2.4" fill="none"/><circle cx="12" cy="12" r="3" fill="currentColor"/>',
  split: '<path d="M12 3v18M4 7l8 5-8 5" stroke="currentColor" stroke-width="2.5" fill="none"/>',
};
// Which texture dresses which control: [normal, pressed].
const TOUCH_TEXTURE_OF = {
  jump: ["jump", "jump_pressed"],
  sneak: ["sneak", "sneak_pressed"],
  attack: ["attack", "attack_pressed"],
  use: ["interact", "interact_pressed"],
};
// The small buttons (the top row and its pop-over): Bedrock's dark HUD square with
// its icon. `null`: no Bedrock icon exists, the glyph is drawn on the square.
const TOUCH_ICON_OF = {
  pause: "pause_icon",
  chat: "comment",
  inventory: "inventory_icon",
  more: "more-dots",
  back: "arrow_left_white",
  perspective: "perspective",
  fullscreen: null,
  drop: null,
  split: null,
};
// Capability. `auto` is a coarse primary pointer, or touch points with no fine pointer
// at all; navigator.userAgentData and the user agent are not looked at.
function touchDetect() {
  const coarse = matchMedia("(pointer: coarse)").matches;
  const fine = matchMedia("(any-pointer: fine)").matches;
  const points = (navigator.maxTouchPoints ?? 0) > 0;
  return { coarse, fine, points, auto: coarse || (points && !fine) };
}
function touchEffective(mode) {
  if (mode === "on") return true;
  if (mode === "off") return false;
  return touchDetect().auto || touchSeen;
}
// The embedded textures as { name: dataUrl } ({} when the build has none).
function touchTexturesRead() {
  try {
    const node = document.getElementById("touch-textures");
    const map = node ? JSON.parse(node.textContent) : {};
    return map && typeof map === "object" ? map : {};
  } catch {
    return {};
  }
}
// Keeps the textures that decode.
async function touchTexturesCheck(map) {
  const good = {};
  await Promise.all(
    Object.entries(map).map(
      ([name, url]) =>
        new Promise((done) => {
          const image = new Image();
          image.onload = () => {
            if (image.naturalWidth > 0) good[name] = url;
            done();
          };
          image.onerror = () => done();
          image.src = url;
        }),
    ),
  );
  return good;
}
function touchEl(tag, props = {}, children = []) {
  const node = document.createElement(tag);
  for (const [key, value] of Object.entries(props)) {
    if (key === "class") node.className = value;
    else if (key === "text") node.textContent = value;
    else node.setAttribute(key, value);
  }
  node.append(...children);
  return node;
}
function touchGlyph(name) {
  const span = touchEl("span", { class: "touch-glyph", "aria-hidden": "true" });
  span.innerHTML = `<svg viewBox="0 0 24 24" width="100%" height="100%" focusable="false">${TOUCH_GLYPHS[name] ?? ""}</svg>`;
  return span;
}
// A key as the page can make it: a DOM KeyboardEvent on the canvas, which winit turns
// into a real key event (the game's text screens read winit's KeyEvent, which cannot
// be built from outside winit).
// A US layout: the physical key of a character, and whether Shift makes it.
const TOUCH_KEYS_PLAIN = "`1234567890-=[]\\;',./ ";
const TOUCH_KEYS_SHIFT = '~!@#$%^&*()_+{}|:"<>? ';
const TOUCH_KEYS_CODE = ["Backquote", "Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "Digit6", "Digit7", "Digit8", "Digit9", "Digit0", "Minus", "Equal", "BracketLeft", "BracketRight", "Backslash", "Semicolon", "Quote", "Comma", "Period", "Slash", "Space"];
function touchKeyOf(char) {
  if (/^[a-z]$/.test(char)) return [`Key${char.toUpperCase()}`, false];
  if (/^[A-Z]$/.test(char)) return [`Key${char}`, true];
  let at = TOUCH_KEYS_PLAIN.indexOf(char);
  if (at >= 0) return [TOUCH_KEYS_CODE[at], false];
  at = TOUCH_KEYS_SHIFT.indexOf(char);
  if (at >= 0) return [TOUCH_KEYS_CODE[at], true];
  return ["", false];
}
// Starts the overlay for one Play. `env`: { wasm, canvas, root, settings }.
function touchStart(env) {
  const { wasm, canvas, root } = env;
  const handle = { settings: env.settings, node: null, stopped: false };
  const cleanups = [];
  let textures = {};
  let overlay = null; // { node, frame(), destroy() }
  let lastEffective = null;
  let metaOriginal = null;
  const listen = (target, type, fn, options) => {
    target.addEventListener(type, fn, options);
    touchStats.added += 1;
    cleanups.push(() => {
      target.removeEventListener(type, fn, options);
      touchStats.removed += 1;
    });
  };
  const scaleOf = () => Math.min(150, Math.max(50, Number(handle.settings.touchScale) || 100));
  // ---- the page while playing -------------------------------------------------
  const pageLock = () => {
