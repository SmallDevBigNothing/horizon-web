      banner ? h("p", { class: "banner error", role: "alert" }, banner) : null,
      loading.error ? h("p", { class: "banner error", role: "alert" }, loading.error) : null,
      loading.text ? h("p", { class: "banner", "data-loading": "" }, loading.text) : null,
      unsupported
