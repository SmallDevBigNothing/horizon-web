  const nav = h("nav", { id: "nav", "aria-label": "Main" });
  const page = h("main", { id: "page", tabindex: "-1" });
  let settings = settingsLoad();
  let current = "play";
  let loading = { text: "Loading…", error: null };
  let banner = null;
  let packTab = Object.keys(PACK_KINDS)[0];
  let packBusy = 0;
  const links = new Map();
  const list = h("ul", { class: "nav-list" });
  for (const [id, label] of LAUNCHER_PAGES) {
    const link = h(
      "a",
      { href: `#${id}`, "data-page": id, onclick: (e) => (e.preventDefault(), go(id)) },
