}

// The launcher: Horizon's desktop launcher (launcher/src/*_page.rs) as a web page.
// Play, Profile, Servers, Packs and Settings; the desktop launcher's installs,
// updates, instances, console, agents, export and shortcut pages have no meaning in
// a browser and are left out. A side bar on wide screens, a bottom tab bar on narrow
// ones (style.css). Everything is plain DOM built from text nodes; nothing a player
// typed or a pack named is ever parsed as HTML.




const LAUNCHER_ICONS = {
  play: '<path d="M7 4.5v15l12-7.5z"/>',
  profile: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  servers: '<rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01"/>',
  packs: '<path d="M12 3 3 7.5 12 12l9-4.500z"/><path d="M3 12l9 4.500 9-4.500M3 16.500 12 21l9-4.500"/>',
  settings: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
};
const LAUNCHER_PAGES = [
  ["play", "Play"],
  ["profile", "Profile"],
  ["servers", "Servers"],
  ["packs", "Packs"],
  ["settings", "Settings"],
];
// Builds an element: h("button", { class: "x", onclick }, "text", child...).
function h(tag, props = {}, ...children) {
