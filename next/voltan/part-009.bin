// Code mods (.hmod) for the page: the bytecode cache.
//
// The game compiles a mod's WebAssembly to Pulley bytecode on first load (slow, a
// second or more per mod). The compiled bytes are kept here, in IndexedDB, under
// the key `wasm.mod_cache_key(hmodBytes)` (a hash of the .hmod and the runtime
// version, so a new build never reads an old build's bytecode), and handed back
// to the game next time. The game only trusts them when they deserialize and
// falls back to compiling when they do not.
//
//   const loaded = await prepareMods(wasm, [{ name: "coords-hud", bytes }]);
//   const client = wasm.run_game("horizon", resources, join);   // after set_mod_packages
//   ... once the game has started:
//   await keepCompiledMods(wasm);

const DB_NAME = "horizon-mods";
const STORE = "bytecode";

function openDb() {
  return new Promise((ok, fail) => {
    const request = indexedDB.open(DB_NAME, 1);
    request.onupgradeneeded = () => request.result.createObjectStore(STORE);
    request.onsuccess = () => ok(request.result);
    request.onerror = () => fail(request.error);
  });
}

async function transact(mode, run) {
  const db = await openDb();
  try {
    return await new Promise((ok, fail) => {
      const tx = db.transaction(STORE, mode);
      const result = run(tx.objectStore(STORE));
      tx.oncomplete = () => ok(result.result);
      tx.onerror = () => fail(tx.error);
      tx.onabort = () => fail(tx.error);
    });
  } finally {
    db.close();
  }
}

/** The bytecode kept under `key`, or undefined (also when storage is unavailable). */
async function getCompiled(key) {
  try {
    const bytes = await transact("readonly", (store) => store.get(key));
    return bytes ? new Uint8Array(bytes) : undefined;
  } catch {
    return undefined;
  }
}

/** Keep `bytes` under `key`. Failures (private mode, quota) only cost a recompile. */
async function putCompiled(key, bytes) {
  try {
    await transact("readwrite", (store) => store.put(bytes, key));
    return true;
  } catch {
    return false;
  }
}

/** Forget every kept bytecode. */
async function clearCompiled() {
  try {
    await transact("readwrite", (store) => store.clear());
  } catch {}
}

/**
 * Hand the game its mods before `run_game`: `files` is `[{name, bytes}]`, each
 * with its cached bytecode when this page kept one. Returns how many came from
 * the cache.
 */
async function prepareMods(wasm, files) {
  let cached = 0;
  const packages = [];
  for (const { name, bytes } of files) {
    const compiled = await getCompiled(wasm.mod_cache_key(bytes));
    if (compiled) cached += 1;
    packages.push({ name, bytes, compiled });
  }
  wasm.set_mod_packages(packages);
  return { cached, total: files.length };
}

/** Keep what the game compiled; call it once the game has loaded its mods. */
async function keepCompiledMods(wasm) {
  const fresh = wasm.take_compiled_mods();
  for (const { key, bytes } of fresh) await putCompiled(key, bytes);
  return fresh.length;
}

// One Play: a fresh canvas and a freshly instantiated game, from the launcher's
// profile, server and packs, and its end. Quitting (the title screen's Quit Game, or
// the page asking) makes the game save, close its connection, stop its event loop and
// call `window.horizonQuit(reason)`; the page then removes the canvas, drops the
// instance and shows the launcher again. Nothing reloads, and nothing of the game is
// reused: the next Play starts a new instance from the compiled module.






let sessionActive = null;
function sessionRunning() {
  return sessionActive !== null;
}
// `ctx`: makeInstance(), resources (the .hwp bytes), settings, join (a server address
// or undefined), relay (override or undefined), report (window.horizonBoot), root (the
// element that gets the canvas), onStart(), onEnd(reason, error).
async function sessionStart(ctx) {
