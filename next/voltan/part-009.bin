  // ---- Profile -----------------------------------------------------------
  function renderProfile() {
    put(page, h("h1", {}, "Profile"));
    const mount = h("div", { id: "profile-mount", "data-launcher-mount": "profile" });
    (launcherRegistry.get("profile") ?? profileRenderPage)(mount, { toast, ask, service, h, field, segmented });
    put(page, mount);
  }
  // ---- Servers -----------------------------------------------------------
  function serverDialog(existing, done) {
    const relays = relayLoad();
    const name = h("input", { type: "text", value: existing?.name ?? "", maxLength: 64, autocomplete: "off" });
    const address = h("input", {
      type: "text",
      value: existing?.address ?? "",
      placeholder: "play.example.net:25565",
      autocomplete: "off",
      autocapitalize: "off",
      spellcheck: false,
    });
    const relay = select(
      [["", "My chosen relay"], ...relays.map((r) => [r.url, r.name])],
      existing?.relay ?? "",
      () => {},
      "Relay",
    );
    const error = h("p", { class: "banner error", role: "alert", hidden: true });
    const dialog = h(
      "dialog",
      { class: "dialog", "aria-label": existing ? "Edit server" : "Add server" },
      h(
        "form",
        {
          method: "dialog",
          onsubmit: (e) => {
            const clean = serversNormalise(address.value);
            if (!clean) {
              e.preventDefault();
              error.textContent = "Use host, host:port, or ws://host:port";
              error.hidden = false;
              address.focus();
              return;
            }
            done({ name: name.value.trim() || clean, address: clean, relay: relay.value });
          },
        },
        h("h2", {}, existing ? "Edit server" : "Add server"),
        field("Name", name),
        field("Address", address),
        field("Relay", relay),
        error,
        h(
          "div",
          { class: "actions" },
          h("button", { type: "button", class: "button", onclick: () => dialog.close() }, "Cancel"),
          h("button", { type: "submit", class: "button primary" }, "Save"),
        ),
      ),
    );
    dialog.addEventListener("close", () => dialog.remove());
    root.append(dialog);
    dialog.showModal();
    name.focus();
  }
  function renderServers() {
    const servers = serversLoad();
    const rows = h("ol", { class: "index-list", "aria-label": "Servers" });
    servers.forEach((server, i) => {
      const result = h("span", { class: "detail", "aria-live": "polite" }, server.address);
      const act = (fn) => () => fn(server, i, result);
      rows.append(
        h(
          "li",
          { class: "row" },
          h("span", { class: "index" }, String(i + 1).padStart(2, "0")),
          h("div", { class: "main" }, h("b", {}, server.name), result),
          h(
            "div",
            { class: "controls" },
            h("button", { type: "button", class: "button", onclick: act(pingServer) }, "Ping"),
            h(
              "button",
              {
                type: "button",
                class: "button primary",
                disabled: Boolean(loading.text) || Boolean(loading.error),
                onclick: () => play({ join: server.address, relay: server.relay || undefined }),
              },
              "Play here",
            ),
            h(
              "button",
              {
                type: "button",
                class: "button",
                "aria-label": `Edit ${server.name}`,
                onclick: () =>
                  serverDialog(server, (next) => {
                    servers[i] = next;
                    serversSave(servers);
                    go("servers");
                  }),
              },
              "Edit",
            ),
            h(
              "button",
              {
                type: "button",
                class: "button danger",
                "aria-label": `Remove ${server.name}`,
                onclick: async () => {
                  if (!(await ask(`Remove ${server.name}?`, "Remove"))) return;
                  servers.splice(i, 1);
                  serversSave(servers);
                  go("servers");
                },
              },
              "Remove",
            ),
          ),
        ),
      );
    });
    put(page, 
      h("h1", {}, "Servers"),
      servers.length === 0
        ? h("p", { class: "empty" }, "No servers yet. Add one to join it from Play.")
        : rows,
      h(
        "button",
        {
          type: "button",
          class: "button",
          onclick: () =>
            serverDialog(null, (next) => {
              servers.push(next);
              serversSave(servers);
              go("servers");
            }),
        },
        "Add server",
      ),
      renderRelays(),
    );
  }
  async function pingServer(server, _i, result) {
    result.textContent = "Pinging…";
    try {
      service.set_proxy(server.relay || relayChosen(params.get("proxy") ?? undefined));
      const reply = JSON.parse(await service.ping_server(server.address));
      const status = reply.status ?? {};
      const motd = typeof status.description === "string" ? status.description : (status.description?.text ?? "");
      const players = status.players ? `${status.players.online}/${status.players.max} players` : "";
      result.textContent = [`${Math.round(reply.ms)} ms`, players, motd].filter(Boolean).join(", ");
    } catch (error) {
      result.textContent = `No answer: ${error?.message ?? error}`;
    }
  }
  function renderRelays() {
    const relays = relayLoad();
    const chosen = relayChosen(params.get("proxy") ?? undefined);
    const rows = h("ol", { class: "index-list", "aria-label": "Relays" });
    relays.forEach((relay, i) => {
      rows.append(
        h(
          "li",
          { class: "row" },
          h("span", { class: "index" }, String(i + 1).padStart(2, "0")),
          h("div", { class: "main" }, h("b", {}, relay.name), h("span", { class: "detail" }, relay.url)),
          h(
            "div",
            { class: "controls" },
            h(
              "button",
              {
                type: "button",
                class: "button",
                "aria-pressed": String(relay.url === chosen),
                onclick: () => (relaySetChosen(relay.url), go("servers")),
              },
              relay.url === chosen ? "In use" : "Use",
            ),
            relays.length > 1
              ? h(
                  "button",
                  {
                    type: "button",
                    class: "button danger",
                    "aria-label": `Remove relay ${relay.name}`,
                    onclick: () => (relayRemove(relay.url), go("servers")),
                  },
                  "Remove",
                )
              : null,
          ),
        ),
      );
    });
    const name = h("input", { type: "text", placeholder: "Name", autocomplete: "off", "aria-label": "Relay name" });
    const url = h("input", {
      type: "text",
      placeholder: "ws://host:25580",
      autocomplete: "off",
      autocapitalize: "off",
      spellcheck: false,
      "aria-label": "Relay address",
    });
    const error = h("p", { class: "banner error", role: "alert", hidden: true });
    return h(
      "section",
      { class: "section", "aria-label": "Relays" },
      h("h2", {}, "Relays"),
      h(
        "p",
        { class: "hint" },
        "A relay (horizon-web-proxy) carries the game's connection to a server. Add the address of one you run.",
      ),
      rows,
      h(
        "form",
        {
          class: "inline-form",
          onsubmit: (e) => {
            e.preventDefault();
            const problem = relayAdd(name.value, url.value);
            if (problem) {
              error.textContent = problem;
              error.hidden = false;
              return;
            }
            go("servers");
          },
        },
        name,
        url,
        h("button", { type: "submit", class: "button" }, "Add relay"),
        error,
      ),
    );
  }
  // ---- Packs -------------------------------------------------------------
  // The manifest of a .hmod, read in the launcher's own instance.
  async function modInfo(pack) {
    if (pack.meta) return pack;
    const path = `horizon-mods/.inspect-${pack.id}.hmod`;
    let meta;
    try {
      service.add_uploaded_file(path, pack.bytes);
      meta = JSON.parse(service.mod_info(path));
    } catch (error) {
      meta = { error: String(error?.message ?? error ?? "unreadable") };
    } finally {
      service.remove_uploaded_file(path);
    }
    const next = { ...pack, meta };
    await packsUpdate(next);
    return next;
  }
  async function renderPacks() {
    const token = ++packBusy;
    const tabs = h("div", { class: "tabs", role: "tablist", "aria-label": "Pack kinds" });
    const kinds = Object.keys(PACK_KINDS);
    const panel = h("div", { class: "tabpanel", role: "tabpanel", tabindex: "0", id: "pack-panel" });
    kinds.forEach((kind) => {
      tabs.append(
        h(
          "button",
          {
            type: "button",
            role: "tab",
            id: `tab-${kind}`,
            class: "tab",
            "aria-selected": String(kind === packTab),
            "aria-controls": "pack-panel",
            tabindex: kind === packTab ? 0 : -1,
            onclick: () => ((packTab = kind), go("packs")),
            onkeydown: (e) => {
              const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
              if (!step) return;
              packTab = kinds[(kinds.indexOf(kind) + step + kinds.length) % kinds.length];
              go("packs");
              requestAnimationFrame(() => document.getElementById(`tab-${packTab}`)?.focus());
            },
          },
          PACK_KINDS[kind].label,
        ),
      );
    });
    panel.setAttribute("aria-labelledby", `tab-${packTab}`);
    put(page, h("h1", {}, "Packs"), tabs, panel);
    const kind = packTab;
    const webgl = settingsIsWebgl(settings.renderer, null);
    const disabled = kind === "shader" && webgl;
    let packs = await packsList(kind);
    if (kind === "mod") packs = await Promise.all(packs.map(modInfo));
    if (token !== packBusy || current !== "packs") return;
    const intro = {
      mod: "Horizon mods (.hmod). Content mods add blocks, items, data and assets, and load when you play.",
      resource: "Resource packs (.zip). Packs higher in the list win.",
      data: "Data packs (.zip), kept here and sent to the game with your other packs. Servers send their own.",
      shader: "Shader packs for WebGPU (.hshader). One is on at a time.",
    }[kind];
    const add = h("input", {
      type: "file",
      multiple: true,
      accept: PACK_KINDS[kind].accept,
      class: "visually-hidden",
      id: "pack-file",
      disabled,
      onchange: async () => {
        for (const file of add.files) {
          try {
            await packsAdd(kind, file);
          } catch (error) {
            toast(String(error?.message ?? error));
          }
        }
        go("packs");
      },
    });
    const drop = h(
      "div",
      { class: "drop" },
      h("label", { class: "button", for: "pack-file", tabindex: disabled ? -1 : 0, role: "button" }, "Add files"),
      h("span", { class: "hint" }, "or drop them here"),
    );
    drop.addEventListener("dragover", (e) => (e.preventDefault(), drop.classList.add("over")));
    drop.addEventListener("dragleave", () => drop.classList.remove("over"));
    drop.addEventListener("drop", async (e) => {
      e.preventDefault();
      drop.classList.remove("over");
      if (disabled) return;
      for (const file of e.dataTransfer.files) {
        try {
          await packsAdd(kind, file);
        } catch (error) {
          toast(String(error?.message ?? error));
        }
      }
      go("packs");
    });
    drop.addEventListener("keydown", (e) => (e.key === "Enter" || e.key === " ") && e.target.click?.());
    const rows = h("ol", { class: "index-list", "aria-label": PACK_KINDS[kind].label });
    // Highest priority first.
    const shown = [...packs].reverse();
    shown.forEach((pack, i) => {
      const detail = [sizeText(pack.size)];
      const warnings = [];
      let title = pack.name;
      if (kind === "mod") {
        if (pack.meta?.error) warnings.push(`Can't be read: ${pack.meta.error}`);
        else if (pack.meta) {
          title = `${pack.meta.name} ${pack.meta.version}`;
          if (pack.meta.description) detail.push(pack.meta.description);
          if (pack.meta.content) detail.push("content");
        }
      }
      const move = async (delta) => {
        await packsMove(pack.id, delta);
        go("packs");
      };
      const toggle = h("input", {
        type: "checkbox",
        role: "switch",
        checked: pack.enabled && !disabled,
        disabled,
        "aria-label": `${title} on`,
        onchange: async () => {
          if (kind === "shader" && toggle.checked) {
            for (const other of packs) if (other.id !== pack.id && other.enabled) await packsUpdate({ ...other, enabled: false });
          }
          await packsUpdate({ ...pack, enabled: toggle.checked });
          go("packs");
        },
      });
      rows.append(
        h(
          "li",
          { class: "row" },
          h("span", { class: "index" }, String(i + 1).padStart(2, "0")),
          h(
            "div",
            { class: "main" },
            h("b", {}, title),
            h("span", { class: "detail" }, detail.join(" · ")),
            warnings.map((w) => h("span", { class: "warn" }, w)),
          ),
          h(
            "div",
            { class: "controls" },
            h("label", { class: "switch" }, toggle, h("span", { class: "track", "aria-hidden": "true" })),
            kind === "resource" || kind === "data"
              ? h(
                  "button",
                  { type: "button", class: "button icon", "aria-label": `Move ${title} up`, disabled: disabled || i === 0, onclick: () => move(1) },
                  "↑",
                )
              : null,
            kind === "resource" || kind === "data"
              ? h(
                  "button",
                  {
                    type: "button",
                    class: "button icon",
                    "aria-label": `Move ${title} down`,
                    disabled: disabled || i === shown.length - 1,
                    onclick: () => move(-1),
                  },
                  "↓",
                )
              : null,
            h(
              "button",
              {
                type: "button",
                class: "button danger",
                "aria-label": `Delete ${title}`,
                disabled,
                onclick: async () => {
                  if (!(await ask(`Delete ${title}?`, "Delete"))) return;
                  await packsRemove(pack.id);
                  go("packs");
                },
              },
              "Delete",
            ),
          ),
        ),
      );
    });
    put(panel, 
      disabled ? h("p", { class: "banner", role: "note" }, "Shader packs need WebGPU") : null,
      h("p", { class: "hint" }, intro),
      packs.length === 0 ? h("p", { class: "empty" }, `No ${PACK_KINDS[kind].label.toLowerCase()} yet.`) : rows,
      h("div", { class: "drop-wrap", "aria-disabled": String(disabled) }, add, drop),
    );
    if (disabled) panel.classList.add("greyed");
    panel.setAttribute("aria-disabled", String(disabled));
  }
  // ---- Settings ----------------------------------------------------------
  function renderSettings() {
    const detected = (() => {
      const coarse = matchMedia("(pointer: coarse)").matches || navigator.maxTouchPoints > 0;
      return coarse ? "Touch screen found" : "No touch screen found";
    })();
    const scaleOut = h("output", { class: "mono" }, `${settings.touchScale}%`);
    const scale = h("input", {
      type: "range",
      min: 50,
      max: 150,
      step: 5,
      value: settings.touchScale,
      oninput: () => {
        scaleOut.textContent = `${scale.value}%`;
      },
      onchange: () => saveSettings({ touchScale: Number(scale.value) }),
    });
    put(page, 
      h("h1", {}, "Settings"),
      h(
        "div",
        { class: "form" },
        field(
          "Language",
          select(SETTINGS_LANGUAGES, settings.lang, (value) => saveSettings({ lang: value }), "Language"),
          "The game's language when it starts.",
        ),
        field(
          "Theme",
          segmented("Theme", [["system", "System"], ["light", "Light"], ["dark", "Dark"]], settings.theme, (value) => saveSettings({ theme: value })),
        ),
        field(
          "Renderer",
          segmented(
            "Renderer",
            [["auto", "Auto"], ["webgpu", "WebGPU"], ["webgl", "WebGL"]],
            settings.renderer,
            (value) => (saveSettings({ renderer: value }), go("settings")),
          ),
          settings.renderer === "webgl" || settingsIsWebgl(settings.renderer, null)
            ? "Compatibility mode: the basic Minecraft look, shader packs are off."
            : "Auto picks WebGPU when the browser has it, WebGL when it does not.",
        ),
        field(
          "Touch controls",
          segmented("Touch controls", [["auto", "Auto"], ["on", "On"], ["off", "Off"]], settings.touch, (value) => saveSettings({ touch: value })),
          `Auto shows them on devices with a touch screen. ${detected}.`,
        ),
        field("Touch control size", h("div", { class: "range" }, scale, scaleOut)),
      ),
      h(
        "section",
        { class: "section" },
        h("h2", {}, "Launcher data"),
        h("p", { class: "hint" }, "Settings, servers, relays and saved packs are kept in this browser."),
        h(
          "button",
          {
            type: "button",
            class: "button danger",
            onclick: async () => {
              if (!(await ask("Clear all launcher data in this browser?", "Clear"))) return;
              for (const key of Object.keys(localStorage)) if (key.startsWith("horizon.")) localStorage.removeItem(key);
              for (const db of ["voltan-packs", "voltan-uploads", "voltan-profile"]) indexedDB.deleteDatabase(db);
              settings = settingsLoad();
              settingsApplyTheme(settings.theme);
              toast("Launcher data cleared.");
              go("settings");
            },
          },
          "Clear launcher data",
        ),
      ),
    );
  }
  // ---- Routing -----------------------------------------------------------
  function render() {
    page.replaceChildren();
    page.dataset.page = current;
    page.setAttribute("aria-label", LAUNCHER_PAGES.find(([id]) => id === current)[1]);
    for (const [id, link] of links) {
      if (id === current) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }
    ({ play: renderPlay, profile: renderProfile, servers: renderServers, packs: renderPacks, settings: renderSettings })[current]();
  }
  function go(id) {
    current = id;
    if (location.hash !== `#${id}`) history.replaceState(history.state, "", `#${id}`);
    render();
  }
  addEventListener("hashchange", () => {
    const id = location.hash.slice(1);
    if (links.has(id) && id !== current) go(id);
  });
  globalThis.horizonLauncher.refresh = () => render();
  return {
    show(error) {
      banner = error;
      root.hidden = false;
      document.body.classList.remove("playing");
      const id = location.hash.slice(1);
      current = error ? "play" : links.has(id) ? id : current;
      render();
      page.focus({ preventScroll: true });
    },
    hide() {
      root.hidden = true;
    },
    setLoading(text, error = null) {
      loading = { text, error };
      if (current === "play" || current === "servers") render();
    },
  };
}

// The page's startup, shared by the development page (bootstrap.js, ES modules
// served over http) and the single-file page (web/build-single.py, one classic
// script that runs from file://).
//
// The launcher is the page: it opens first, and Play starts the game on a fresh
// canvas (session.js). Rust owns everything after that: winit's web backend sizes
// the canvas, delivers its events and drives frames, and Horizon's renderer draws
// through WebGPU. When the game ends the launcher is shown again, with no reload.






const status = document.getElementById("status");
// Read by the browser smoke tests (web/tests/*.mjs).
const report = {
  state: "loading", // loading | launcher | (the game's: loading, running) | error
  adapter: null,
  backend: null,
  resources: null,
  frames: 0,
  error: null,
  launcher: "loading", // loading | ready | playing
  plays: 0,
};
window.horizonBoot = report;
function show(text, error = false) {
  status.textContent = text;
  status.hidden = text === "";
  status.classList.toggle("error", error);
}
function fail(message) {
  report.state = "error";
  report.error = String(message);
  show(`Voltan could not start:\n${report.error}`, true);
  console.error("Horizon web failed:", message);
}
// `makeInstance()` gives a new, initialised WebAssembly instance (its exports); it
// is called once for the launcher's own use and once for every Play, so a game that
// ended is dropped whole. `loadResources(show, version)` gives the resource package's bytes
// (or nothing); `params` is the page's query.
async function boot({ makeInstance, loadResources, params }) {
  try {
    await start({ makeInstance, loadResources, params });
  } catch (error) {
    fail(error);
  }
}
async function start({ makeInstance, loadResources, params }) {
  if (!("gpu" in navigator) && !document.createElement("canvas").getContext("webgl2")) {
    fail("this browser has neither WebGPU nor WebGL 2. Use a current Chrome, Edge, Firefox or Safari.");
    return;
  }
  const settings = settingsLoad();
  settingsApplyTheme(settings.theme);
  show("Loading Voltan…");
  installUploads();
  await packsMigrate();
  // The launcher's own instance: version, pinging servers, reading a mod's manifest.
  const service = await makeInstance();
  const brand = `Voltan - Vanilla ${service.game_version()} (Rust)`;
  document.title = brand;
  const launcher = createLauncher({
    service,
    brand,
    protocol: service.protocol_version(),
    params,
    report,
    play: (options) => play(options),
  });
  let resources = null;
  let ready = false;
  const play = async ({ join, relay } = {}) => {
    if (!ready || report.launcher === "playing") return;
    // Still inside the Play tap: the one moment full screen may be asked for.
    touchPlayGesture(settingsLoad().touch);
    report.plays += 1;
    report.error = null;
    await sessionStart({
      makeInstance,
      resources,
      settings: settingsLoad(),
      join,
      relay: params.get("proxy") ?? relay ?? undefined,
      report,
      root: document.getElementById("game-root"),
      onStart: () => {
        report.launcher = "playing";
        report.state = "loading";
        document.body.classList.add("playing");
        launcher.hide();
      },
      onFrame: (client) => document.body.classList.toggle("running", client.state === "running"),
      onEnd: (reason, error) => {
        report.launcher = "ready";
        document.body.classList.remove("playing", "running");
        launcher.show(reason === "error" ? (error ?? "The game stopped.") : null);
      },
    });
  };
  report.state = "launcher";
  show("");
  launcher.show(null);
  launcher.setLoading("Loading the game files…");
  try {
    resources = await loadResources((text) => {
      launcher.setLoading(text);
      show(text);
    }, service.game_version());
  } catch (error) {
    launcher.setLoading(null, `The game files could not be loaded: ${error?.message ?? error}`);
    throw error;
  }
  show("");
  // The default skins for the Profile page's preview come from the resources.
  if (resources) profileMountResources(service, resources);
  ready = true;
  report.launcher = "ready";
  launcher.setLoading(null);
  // ?autoplay=1 starts the game at once, as the page did before the launcher
  // (the smoke tests); ?join=host:port joins that server.
  if (params.get("autoplay") === "1" || params.get("join")) {
    play({ join: params.get("join") ?? undefined });
  }
}

// The single-file page's start. This file is appended after the wasm-bindgen glue
// (wrapped as `makeGlue()`, so each Play gets an instance of its own) and the page's
// modules (relays, settings, uploads, profile, session, launcher, core) with their imports
// and exports removed. The WebAssembly and the resource package are in the page, as
// base64 in inert <script data-blob="..."> elements, gzip-compressed.

(function () {
  const params = new URLSearchParams(location.search);

  // The bytes of an embedded blob, or nothing if the page has none.
  async function readBlob(name) {
    const parts = [...document.querySelectorAll(`script[data-blob="${name}"]`)].sort(
      (a, b) => Number(a.dataset.index) - Number(b.dataset.index),
    );
    if (parts.length === 0) return undefined;
    const packed = new Uint8Array(Number(parts[0].dataset.size));
    let at = 0;
    for (const part of parts) {
      const text = atob(part.textContent);
      for (let i = 0; i < text.length; i++) packed[at + i] = text.charCodeAt(i);
      at += text.length;
      // Free the text: the bytes are kept.
      part.textContent = "";
    }
    if (!parts[0].dataset.gzip) return packed;
    const stream = new Blob([packed]).stream().pipeThrough(new DecompressionStream("gzip"));
    return new Uint8Array(await new Response(stream).arrayBuffer());
  }

  // A page made without the resource package asks for it once and keeps it in the
  // browser (IndexedDB).
  const PACKAGE_DB = "voltan-package";
  function packageDb() {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(PACKAGE_DB, 1);
      request.onupgradeneeded = () => request.result.createObjectStore("package");
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }
  async function packageStore(mode, work) {
    const db = await packageDb();
    return new Promise((resolve, reject) => {
      const transaction = db.transaction("package", mode);
      const result = work(transaction.objectStore("package"));
      transaction.oncomplete = () => resolve(result.result);
      transaction.onerror = () => reject(transaction.error);
    });
  }
  async function packageFromPicker(show) {
    try {
      const kept = await packageStore("readonly", (store) => store.get("hwp"));
      if (kept) return kept;
    } catch (error) {
      console.warn("Voltan: could not read the kept resource package", error);
    }
    show("This page has no game files inside. Choose your resource package (a .hwp file).");
    return new Promise((resolve) => {
      const button = document.createElement("button");
      button.id = "pick";
      button.textContent = "Choose the resource package…";
      button.addEventListener("click", () => {
        const input = document.createElement("input");
        input.type = "file";
        input.accept = ".hwp";
        input.addEventListener("change", async () => {
          const file = input.files[0];
          if (!file) return;
          show("reading the resource package…");
          button.remove();
          const bytes = new Uint8Array(await file.arrayBuffer());
          try {
            await packageStore("readwrite", (store) => store.put(bytes, "hwp"));
          } catch (error) {
            console.warn("Voltan: could not keep the resource package for the next visit", error);
          }
          resolve(bytes);
        });
        input.click();
      });
      document.body.append(button);
    });
  }

  // The WebAssembly is compiled once; every instance (the launcher's own, one per
  // Play) comes from the compiled module with glue of its own.
  let compiled = null;
  boot({
    makeInstance: async () => {
      if (!compiled) {
        const bytes = await readBlob("wasm");
        if (!bytes) throw new Error("this page has no WebAssembly inside");
        compiled = await WebAssembly.compile(bytes);
      }
      const wasm = makeGlue();
      await wasm({ module_or_path: compiled });
      return wasm;
    },
    loadResources: async (show) => {
      show("unpacking the game files…");
      return (await readBlob("package")) ?? (await packageFromPicker(show));
    },
    params,
  });
})();

</script>
</body>
</html>
