<script>
// Browsers keep sound off until the player clicks or presses a key: the
// game's audio contexts (cpal's) start suspended and are resumed then. Loaded
// before the game's glue, which keeps the AudioContext class it finds.
const contexts = [];
globalThis.horizonAudioContexts = contexts; // for diagnostics
if (globalThis.AudioContext) {
    const BrowserAudioContext = globalThis.AudioContext;
    globalThis.AudioContext = class extends BrowserAudioContext {
        constructor(...args) {
            super(...args);
            contexts.push(this);
        }
        // A context closed while a resume is pending (the game ended) is not an error.
        resume() {
            return super.resume().catch(() => {});
        }
    };
    // The loudest sample played so far (globalThis.horizonAudioPeak), for the smoke tests.
    globalThis.horizonAudioPeak = 0;
    const copyToChannel = AudioBuffer.prototype.copyToChannel;
    AudioBuffer.prototype.copyToChannel = function (source, ...rest) {
        for (const v of source) {
            if (Math.abs(v) > globalThis.horizonAudioPeak) globalThis.horizonAudioPeak = Math.abs(v);
        }
        return copyToChannel.call(this, source, ...rest);
    };
    const resume = () => {
        for (const ctx of contexts) {
            if (ctx.state === "suspended") ctx.resume().catch(() => {});
        }
    };
    // The launcher closes the game's contexts when the game ends (quit), so a
    // dropped game leaves none running.
    globalThis.horizonCloseAudio = () => {
        for (const ctx of contexts.splice(0)) ctx.close().catch(() => {});
    };
    addEventListener("pointerdown", resume, true);
    addEventListener("keydown", resume, true);
}

