          "div",
          {},
          h("b", {}, profileSummary() ?? "No profile yet"),
          h(
            "p",
            { class: "hint" },
            profileSummary() ? "Your name and skin when you play." : "The game uses a generated name and Steve until you save one.",
          ),
        ),
        h("a", { class: "button", href: "#profile", onclick: (e) => (e.preventDefault(), go("profile")) }, "Edit"),
      ),
      h(
        "div",
        { class: "form" },
        field("Server", serverSelect, "Pick a saved server to join it, or none to start at the menu."),
        field(
          "Relay",
