    node.append(moveZone, lookZone, menuZone, stick, strip, actions, popover, top, rightChip, rotate, input);
    // The overlay is above the canvas, below nothing.
    root.append(node);
    // ---- per-frame upkeep
    let hotbarKey = "";
    const portrait = matchMedia("(orientation: portrait)");
    const frame = () => {
      if (handle.stopped) return;
      let now = 3;
      try {
